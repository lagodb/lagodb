-- Runtime remote-object cleanup: asynchronous DROP and queue semantics.
-- End-to-end asynchronous remote DROP. setup.sql provisions
-- the MinIO fixture and records its connection details in the test database.
-- pg_regress unsets PGDATABASE and passes the database only via psql -d. Export
-- it so the \! helper scripts connect to this regress database. \! does not
-- interpolate psql variables (OT_WHOLE_LINE); \setenv (OT_NORMAL) does.
\setenv PGDATABASE :DBNAME
SELECT endpoint AS lagodb_regress_endpoint,
       bucket AS lagodb_regress_bucket,
       region AS lagodb_regress_region,
       access_key_id AS lagodb_regress_access_key_id,
       secret_access_key AS lagodb_regress_secret_access_key
FROM lagodb_regress.object_storage_fixture
\gset
SET client_min_messages = warning;
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
RESET client_min_messages;
CREATE EXTENSION lagodb_iceberg;
SET client_min_messages = warning;
DROP TABLE IF EXISTS remote_cleanup_drop;
DROP TABLE IF EXISTS remote_cleanup_rollback;
DROP TABLESPACE IF EXISTS regress_object;
RESET client_min_messages;
--
-- Test 0: Local table artifact cleanup
--
CREATE TABLE test_lifecycle (id int) USING iceberg;
INSERT INTO test_lifecycle VALUES (1), (2), (3);
-- Capture the PG relation-file root while the table exists.
SELECT pg_relation_filepath('test_lifecycle'::regclass) || '_iceberg' AS path_1 \gset
-- Verify directory exists
SELECT (pg_stat_file(:'path_1')).isdir as directory_found;
 directory_found 
-----------------
 t
(1 row)

SELECT EXISTS (
    SELECT 1 FROM pg_ls_dir(:'path_1', true, false)
) AS root_has_iceberg_artifacts;
 root_has_iceberg_artifacts 
----------------------------
 t
(1 row)

DROP TABLE test_lifecycle;
-- Verify directory is gone
SELECT (pg_stat_file(:'path_1', true)) is null as directory_missing;
 directory_missing 
-------------------
 t
(1 row)

SELECT count(*) AS local_drop_remote_items
FROM lagodb.maintenance_queue
WHERE producer = 'iceberg-drop';
 local_drop_remote_items 
-------------------------
                       0
(1 row)

\! mkdir -p /tmp/iceberg_regress_object
\! rm -rf /tmp/iceberg_regress_object/*
SELECT 'regress-object-' || gen_random_uuid() AS volume_name \gset
SELECT lagodb.create_storage_volume(
    :'volume_name',
    format('s3://%s', :'lagodb_regress_bucket'),
    jsonb_build_object(
        'type', 's3_access_key',
        'access_key_id', :'lagodb_regress_access_key_id',
        'secret_access_key', :'lagodb_regress_secret_access_key'
    ),
    jsonb_build_object(
        'region', :'lagodb_regress_region',
        'endpoint', :'lagodb_regress_endpoint',
        'allow_http', true
    )
) AS created_volume \gset
CREATE TABLESPACE regress_object
LOCATION '/tmp/iceberg_regress_object'
WITH (storage_volume = :'volume_name');
SELECT internal_volume_id AS volume_id,
       regexp_replace(effective_location, '^[^:]+://[^/]+/', '') AS effective_root
FROM lagodb.storage_volumes
WHERE storage_volume_name = :'volume_name'
\gset
\setenv LAGODB_REGRESS_VOLUME_ID :volume_id
\setenv LAGODB_REGRESS_OBJECT_NAMESPACE :lagodb_regress_bucket
\! bin/wait_for_object_store 30
object_store_ready: true
SELECT list_succeeded
       AND write_succeeded
       AND read_succeeded
       AND delete_succeeded
       AND succeeded
       AND error IS NULL AS storage_volume_probe_ok
FROM lagodb.probe_storage_volume(:'volume_name');
 storage_volume_probe_ok 
-------------------------
 t
(1 row)

CREATE TABLE remote_cleanup_drop (id integer)
USING iceberg TABLESPACE regress_object;
INSERT INTO remote_cleanup_drop
SELECT generate_series(1, 1000);
SELECT :'volume_id' AS volume_id,
       :'lagodb_regress_bucket' AS object_namespace,
       value AS remote_location,
       regexp_replace(value,
                      '^[^:]+://[^/]+/', '') || '/' AS object_path
FROM lagodb.table_option_values
WHERE relid = 'remote_cleanup_drop'::regclass AND name = 'location'
\gset
SELECT :'object_path' = :'effective_root' || '/' || current_database()
           || '/public/remote_cleanup_drop/'
           || 'remote_cleanup_drop'::regclass::oid || '/'
           AS readable_oid_remote_location;
 readable_oid_remote_location 
------------------------------
 t
(1 row)

SELECT relfilenode::text AS remote_old_relfilenode
FROM pg_class WHERE oid = 'remote_cleanup_drop'::regclass \gset
TRUNCATE remote_cleanup_drop;
SELECT count(*) = 0 AS remote_truncate_empty,
       (SELECT value
        FROM lagodb.table_option_values
        WHERE relid = 'remote_cleanup_drop'::regclass
          AND name = 'location') = :'remote_location'
           AS remote_location_unchanged,
       (SELECT relfilenode FROM pg_class
        WHERE oid = 'remote_cleanup_drop'::regclass)
           <> :'remote_old_relfilenode'::oid AS remote_relfilenode_changed
FROM remote_cleanup_drop;
 remote_truncate_empty | remote_location_unchanged | remote_relfilenode_changed 
-----------------------+---------------------------+----------------------------
 t                     | t                         | t
(1 row)

\setenv LAGODB_REGRESS_VOLUME_ID :volume_id
\setenv LAGODB_REGRESS_OBJECT_NAMESPACE :object_namespace
\setenv LAGODB_REGRESS_OBJECT_PATH :object_path
SELECT objects > 0 AS tree_exists_before_drop
FROM lagodb.observe_object_tree(
    :'volume_id', :'object_namespace', :'object_path'
);
 tree_exists_before_drop 
-------------------------
 t
(1 row)

DROP TABLE remote_cleanup_drop;
\! bin/wait_for_maintenance_item 30
maintenance_complete: true
SELECT objects = 0 AS tree_empty_after_drop
FROM lagodb.observe_object_tree(
    :'volume_id', :'object_namespace', :'object_path'
);
 tree_empty_after_drop 
-----------------------
 t
(1 row)

SELECT count(*) AS relation_gone
FROM pg_class WHERE relname = 'remote_cleanup_drop';
 relation_gone 
---------------
             0
(1 row)

CREATE TABLE remote_cleanup_rollback (id integer)
USING iceberg TABLESPACE regress_object;
INSERT INTO remote_cleanup_rollback VALUES (1), (2);
BEGIN;
DROP TABLE remote_cleanup_rollback;
ROLLBACK;
SELECT array_agg(id ORDER BY id) AS rows_after_drop_rollback
FROM remote_cleanup_rollback;
 rows_after_drop_rollback 
--------------------------
 {1,2}
(1 row)

SELECT :'volume_id' AS volume_id,
       :'lagodb_regress_bucket' AS object_namespace,
       regexp_replace(value,
                      '^[^:]+://[^/]+/', '') || '/' AS object_path
FROM lagodb.table_option_values
WHERE relid = 'remote_cleanup_rollback'::regclass AND name = 'location'
\gset
\setenv LAGODB_REGRESS_VOLUME_ID :volume_id
\setenv LAGODB_REGRESS_OBJECT_NAMESPACE :object_namespace
\setenv LAGODB_REGRESS_OBJECT_PATH :object_path
DROP TABLE remote_cleanup_rollback;
\! bin/wait_for_maintenance_item 30
maintenance_complete: true
SELECT objects = 0 AS rollback_tree_empty_after_cleanup
FROM lagodb.observe_object_tree(
    :'volume_id', :'object_namespace', :'object_path'
);
 rollback_tree_empty_after_cleanup 
-----------------------------------
 t
(1 row)

DROP TABLESPACE regress_object;
\! rm -rf /tmp/iceberg_regress_object/*
-- Transactional and format-neutral queue catalog semantics. All rows remain
-- uncommitted so the concurrently running worker cannot observe them.
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
CREATE EXTENSION lagodb_iceberg;
SELECT operation, state, attempt_count
FROM lagodb.maintenance_status
ORDER BY item_id;
 operation | state | attempt_count 
-----------+-------+---------------
(0 rows)

BEGIN;
INSERT INTO lagodb.maintenance_queue
    (item_id, operation, volume_id, object_namespace, object_path, producer,
     attempt_count, not_before, failed, created_at)
VALUES
    (gen_random_uuid(), 1, 1, 'bucket', 'data/a.parquet',
     'synthetic-iceberg', 0, clock_timestamp(), false, clock_timestamp()),
    (gen_random_uuid(), 1, 1, 'bucket', 'data/a.parquet',
     'synthetic-delta', 0, clock_timestamp(), false, clock_timestamp());
SELECT count(*) AS duplicate_objects_are_distinct
FROM lagodb.maintenance_queue;
 duplicate_objects_are_distinct 
--------------------------------
                              2
(1 row)

ROLLBACK;
SELECT count(*) AS abort_removed_items
FROM lagodb.maintenance_queue;
 abort_removed_items 
---------------------
                   0
(1 row)

BEGIN;
SAVEPOINT maintenance_sp;
INSERT INTO lagodb.maintenance_queue
    (item_id, operation, volume_id, object_namespace, object_path, producer,
     attempt_count, not_before, failed, created_at)
VALUES (gen_random_uuid(), 2, 1, 'bucket', 'table-root/',
        'synthetic-drop', 0, clock_timestamp(), false, clock_timestamp());
INSERT INTO lagodb.maintenance_queue
    (item_id, operation, volume_id, object_namespace, object_path, producer,
     attempt_count, not_before, failed, created_at)
VALUES (gen_random_uuid(), 2, 1, 'bucket', 'table-root/',
        'synthetic-drop', 0, clock_timestamp(), false, clock_timestamp());
SELECT count(*) AS duplicate_trees_are_distinct
FROM lagodb.maintenance_queue;
 duplicate_trees_are_distinct 
------------------------------
                            2
(1 row)

ROLLBACK TO SAVEPOINT maintenance_sp;
SELECT count(*) AS savepoint_removed_items
FROM lagodb.maintenance_queue;
 savepoint_removed_items 
-------------------------
                       0
(1 row)

COMMIT;
SELECT count(*) AS queue_empty_at_end
FROM lagodb.maintenance_queue;
 queue_empty_at_end 
--------------------
                  0
(1 row)

-- The operator retry path is a Rust catalog update, not an SQL UPDATE helper.
SELECT gen_random_uuid() AS retry_id \gset
BEGIN;
INSERT INTO lagodb.maintenance_queue
    (item_id, operation, volume_id, object_namespace, object_path, producer,
     attempt_count, not_before, failed, last_error, created_at)
VALUES (:'retry_id', 1, 1, 'bucket', 'retry/object',
        'synthetic-retry', 7, clock_timestamp(), true, 'forced failure',
        clock_timestamp());
SELECT lagodb.retry_maintenance_item(:'retry_id') AS failed_item_retried;
 failed_item_retried 
---------------------
 t
(1 row)

SELECT state, attempt_count, last_error IS NULL AS error_cleared
FROM lagodb.maintenance_status
WHERE item_id = :'retry_id';
 state | attempt_count | error_cleared 
-------+---------------+---------------
 ready |             0 | t
(1 row)

SELECT lagodb.retry_maintenance_item(:'retry_id') AS ready_item_not_retried;
 ready_item_not_retried 
------------------------
 f
(1 row)

ROLLBACK;
