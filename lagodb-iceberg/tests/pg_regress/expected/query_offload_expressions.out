-- A volatile subtree blocks pruning of the complete OR clause. Forced serial
-- query offload still evaluates the complete expression through PostgreSQL.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) AS rows
FROM query_offload_expression_basic
WHERE (id >= 2 AND random() >= 0)
   OR id <= 1;
                                        QUERY PLAN                                        
------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   PostgreSQL Expression Fallbacks: 1
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_expression_basic
               Access Method: iceberg
               Filter: (((id >= 2) AND (random() >= '0'::double precision)) OR (id <= 1))
(8 rows)

SELECT count(*) AS rows
FROM query_offload_expression_basic
WHERE (id >= 2 AND random() >= 0)
   OR id <= 1;
