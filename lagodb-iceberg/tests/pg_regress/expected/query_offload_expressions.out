-- Native division by zero in non-selected branches proves lazy CASE/COALESCE
-- evaluation, as in PostgreSQL.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) FILTER (
           WHERE CASE WHEN id >= 0 THEN true ELSE 1 / (id - id) > 0 END
       ) AS lazy_case_rows,
       sum(coalesce(value_i4, 1 / (id - id))) AS lazy_coalesce_sum
FROM query_offload_expression_basic
WHERE value_i4 IS NOT NULL;
                                                                                                 QUERY PLAN                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*) FILTER (WHERE CASE WHEN (id >= runtime value) THEN runtime value ELSE ((runtime value / (id - id)) > runtime value) END), SUM(coalesce(value_i4, (runtime value / (id - id))))
         ->  Table Scan on query_offload_expression_basic
               Access Method: iceberg
               Filter: (value_i4 IS NOT NULL)
               Pushed Filter: (value_i4 IS NOT NULL)
(8 rows)

SELECT count(*) FILTER (
           WHERE CASE WHEN id >= 0 THEN true ELSE 1 / (id - id) > 0 END
       ) AS lazy_case_rows,
       sum(coalesce(value_i4, 1 / (id - id))) AS lazy_coalesce_sum
FROM query_offload_expression_basic
WHERE value_i4 IS NOT NULL;
 lazy_case_rows | lazy_coalesce_sum 
----------------+-------------------
              4 |                40
(1 row)

