-- ============================================================================
-- Representative native and PostgreSQL-fallback expression shapes.
-- ============================================================================
-- This compact matrix crosses BooleanTest, searched CASE, COALESCE, NULLIF,
-- native scalar-array comparison, text and numeric scalar functions.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) FILTER (WHERE value_bool IS NOT FALSE) AS boolean_test_rows,
       count(*) FILTER (
           WHERE CASE WHEN id <= 3 THEN true ELSE false END
       ) AS searched_case_rows,
       sum(coalesce(value_i4, 0)) AS coalesce_sum,
       count(*) FILTER (WHERE nullif(id, 3) IS NOT NULL) AS nullif_rows,
       count(*) FILTER (
           WHERE id = ANY (ARRAY[1, 3, NULL]::integer[])
       ) AS any_rows,
       count(*) FILTER (WHERE starts_with(value_text, 'a')) AS prefix_rows,
       count(replace(value_text, 'a', 'A')) AS replaced_rows,
       sum(abs(value_i8)) AS abs_i8_sum,
       sum(abs(value_f8)) AS abs_f8_sum
FROM query_offload_expression_basic;
                                                                                                                                                                                                                                                            QUERY PLAN                                                                                                                                                                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*) FILTER (WHERE (value_bool IS NOT FALSE)), COUNT(*) FILTER (WHERE CASE WHEN (id <= runtime value) THEN runtime value ELSE runtime value END), SUM(coalesce(value_i4, runtime value)), COUNT(*) FILTER (WHERE (nullif(id, runtime value) IS NOT NULL)), COUNT(*) FILTER (WHERE id IN (runtime value, runtime value, runtime value)), COUNT(*) FILTER (WHERE starts_with(value_text, runtime value)), COUNT(replace(value_text, runtime value, runtime value)), SUM(abs(value_i8)), SUM(abs(value_f8))
         ->  Table Scan on query_offload_expression_basic
               Access Method: iceberg
(6 rows)

SELECT count(*) FILTER (WHERE value_bool IS NOT FALSE) AS boolean_test_rows,
       count(*) FILTER (
           WHERE CASE WHEN id <= 3 THEN true ELSE false END
       ) AS searched_case_rows,
       sum(coalesce(value_i4, 0)) AS coalesce_sum,
       count(*) FILTER (WHERE nullif(id, 3) IS NOT NULL) AS nullif_rows,
       count(*) FILTER (
           WHERE id = ANY (ARRAY[1, 3, NULL]::integer[])
       ) AS any_rows,
       count(*) FILTER (WHERE starts_with(value_text, 'a')) AS prefix_rows,
       count(replace(value_text, 'a', 'A')) AS replaced_rows,
       sum(abs(value_i8)) AS abs_i8_sum,
       sum(abs(value_f8)) AS abs_f8_sum
FROM query_offload_expression_basic;
 boolean_test_rows | searched_case_rows | coalesce_sum | nullif_rows | any_rows | prefix_rows | replaced_rows | abs_i8_sum | abs_f8_sum 
-------------------+--------------------+--------------+-------------+----------+-------------+---------------+------------+------------
                 3 |                  3 |           40 |           4 |        2 |           2 |             4 |        800 |         80
(1 row)

