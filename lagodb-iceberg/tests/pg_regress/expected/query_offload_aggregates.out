               Aggregates: COUNT(*)
               ->  Table Scan on public.query_offload_aggregate_basic
                     Access Method: iceberg
                     Scan ID: 0
                     Output: id
                     Filter: (id >= $1)
                     Pushed Filter Conservative: (id >= $1)
