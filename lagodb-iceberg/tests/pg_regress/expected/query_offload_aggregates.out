-- query_offload_aggregates.sql
-- Basic single-relation grouping, aggregate, FILTER, and HAVING coverage.
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
CREATE EXTENSION IF NOT EXISTS lagodb_iceberg;
-- A small batch limit exercises multiple Arrow batches.
-- Keep CustomScan off while comparing query offload with PostgreSQL.
SET lagodb.query_batch_rows = 2;
SET timezone = 'UTC';
CREATE TABLE query_offload_aggregate_basic (
    id integer,
    group_i4 integer,
    group_i8 bigint,
    value_i2 smallint,
    value_i4 integer,
    value_i8 bigint,
    value_f4 real,
    value_f8 double precision,
    value_numeric numeric(12, 2),
    value_bool boolean,
    value_date date,
    value_time time,
    value_timestamp timestamp,
    value_timestamptz timestamptz,
    value_text text,
    value_text_c text COLLATE "C"
) USING iceberg;
INSERT INTO query_offload_aggregate_basic VALUES
    (1, 1, 10,  1,  10,  100,  1.0,  10.0,  1.25, true,
     DATE '2024-01-01', TIME '10:00:00',
     TIMESTAMP '2024-01-01 10:00:00',
     TIMESTAMPTZ '2024-01-01 10:00:00+00', 'alpha', 'alpha'),
    (2, 1, 10,  2,  20,  200,  2.0,  20.0,  2.50, false,
     DATE '2024-01-02', TIME '11:00:00',
     TIMESTAMP '2024-01-02 11:00:00',
     TIMESTAMPTZ '2024-01-02 11:00:00+00', 'beta', 'beta'),
    (3, 2, 20, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
     NULL, NULL, NULL, NULL, NULL, NULL),
    (4, 2, 20, -2, -20, -200, -2.0, -20.0, -2.50, true,
     DATE '2023-12-31', TIME '09:00:00',
     TIMESTAMP '2023-12-31 09:00:00',
     TIMESTAMPTZ '2023-12-31 09:00:00+00', 'alpha', 'alpha'),
    (5, 2, 30,  3,  30,  300,  3.0,  30.0,  3.75, false,
     DATE '2024-01-03', TIME '12:00:00',
     TIMESTAMP '2024-01-03 12:00:00',
     TIMESTAMPTZ '2024-01-03 12:00:00+00', 'gamma', 'gamma'),
    (6, 3, 30, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
     NULL, NULL, NULL, NULL, NULL, NULL);
-- ============================================================================
-- GUC ownership: either path family remains usable while the other is off.
-- ============================================================================
-- Relation CustomScan only.
SET lagodb.customscan_mode = 'force';
SET lagodb.query_offload_mode = 'off';
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM query_offload_aggregate_basic
WHERE id = 1;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Aggregate
   ->  Custom Scan (lagodb-iceberg) on query_offload_aggregate_basic
         Pushed Filter: (id = 1)
(3 rows)

-- Query offload only.
SET lagodb.customscan_mode = 'off';
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM query_offload_aggregate_basic
WHERE id = 1;
                       QUERY PLAN                        
---------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_aggregate_basic
               Access Method: iceberg
               Filter: (id = 1)
               Pushed Filter: (id = 1)
(8 rows)

-- Auto mode prices the offload path against PostgreSQL's plan. Extreme engine
-- costs make each side win whatever the calibrated defaults are.
SET lagodb.query_offload_mode = 'auto';
SET lagodb.query_offload_setup_cost = 1e10;
EXPLAIN (COSTS OFF)
SELECT group_i4, count(*)
FROM query_offload_aggregate_basic
GROUP BY group_i4;
                   QUERY PLAN                    
-------------------------------------------------
 HashAggregate
   Group Key: group_i4
   ->  Seq Scan on query_offload_aggregate_basic
(3 rows)

SET lagodb.query_offload_setup_cost = 0;
SET lagodb.query_offload_cpu_cost_multiplier = 0;
EXPLAIN (COSTS OFF)
SELECT group_i4, count(*)
FROM query_offload_aggregate_basic
GROUP BY group_i4;
                       QUERY PLAN                        
---------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: group_i4
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_aggregate_basic
               Access Method: iceberg
(7 rows)

-- The Iceberg reader's per-row CPU prices only the relation CustomScan, which
-- replaces the SeqScan when CustomScan is on. Against an offload path costing
-- its setup of 10 plus the same pages, the reader cost of the six rows decides:
-- nothing at multiplier 0, and 6 * cpu_tuple_cost * 1000 = 60 at 1000.
SET lagodb.customscan_mode = 'auto';
SET lagodb.query_offload_setup_cost = 10;
SET lagodb_iceberg.scan_cpu_cost_multiplier = 0;
EXPLAIN (COSTS OFF)
SELECT group_i4, count(*)
FROM query_offload_aggregate_basic
GROUP BY group_i4;
                             QUERY PLAN                              
---------------------------------------------------------------------
 HashAggregate
   Group Key: group_i4
   ->  Custom Scan (lagodb-iceberg) on query_offload_aggregate_basic
(3 rows)

SET lagodb_iceberg.scan_cpu_cost_multiplier = 1000;
EXPLAIN (COSTS OFF)
SELECT group_i4, count(*)
FROM query_offload_aggregate_basic
GROUP BY group_i4;
                       QUERY PLAN                        
---------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: group_i4
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_aggregate_basic
               Access Method: iceberg
(7 rows)

RESET lagodb_iceberg.scan_cpu_cost_multiplier;
RESET lagodb.query_offload_setup_cost;
RESET lagodb.query_offload_cpu_cost_multiplier;
SET lagodb.customscan_mode = 'off';
SET lagodb.query_offload_mode = 'force';
-- ============================================================================
-- Metadata COUNT: exact snapshot counts and reader fallback for deletes.
-- ============================================================================
CREATE TABLE query_offload_metadata_count (id integer) USING iceberg;
-- An empty snapshot still produces one COUNT row.
SELECT count(*) FROM query_offload_metadata_count;
 count 
-------
     0
(1 row)

-- Count all rows across two files, including NULL, using a reusable plan.
INSERT INTO query_offload_metadata_count VALUES (1), (NULL);
INSERT INTO query_offload_metadata_count VALUES (3);
PREPARE metadata_count AS SELECT count(*) FROM query_offload_metadata_count;
EXECUTE metadata_count;
 count 
-------
     3
(1 row)

-- COUNT(column) must retain NULL exclusion.
SELECT count(id) FROM query_offload_metadata_count;
 count 
-------
     2
(1 row)

-- Each execution sees current transaction data, not a cached COUNT value.
BEGIN;
INSERT INTO query_offload_metadata_count VALUES (4);
EXECUTE metadata_count;
 count 
-------
     4
(1 row)

ROLLBACK;
EXECUTE metadata_count;
 count 
-------
     3
(1 row)

DEALLOCATE metadata_count;
-- A positional delete requires reader fallback instead of raw file counts.
DELETE FROM query_offload_metadata_count WHERE id = 1;
SELECT count(*) FROM query_offload_metadata_count;
 count 
-------
     2
(1 row)

DROP TABLE query_offload_metadata_count;
-- ============================================================================
-- Unfiltered and filtered grouped aggregates, pure GROUP BY, COUNT, and
-- integer MIN/MAX. The filtered EXPLAIN must show both the exact `Filter`
-- evaluated by DataFusion and the provider-accepted `Pushed Filter` used
-- for Iceberg storage pruning.
-- ============================================================================
-- Query offload plan and result.
EXPLAIN (COSTS OFF)
SELECT group_i4,
       group_i8,
       count(*) AS rows,
       count(value_i4) AS nonnull_i4,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4,
       min(value_i8) AS min_i8,
       max(value_i8) AS max_i8
FROM query_offload_aggregate_basic
GROUP BY group_i4, group_i8
ORDER BY group_i4, group_i8;
                                                   QUERY PLAN                                                    
-----------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: group_i4 ASC NULLS LAST, group_i8 ASC NULLS LAST
         ->  Aggregate
               Group Key: group_i4, group_i8
               Aggregates: COUNT(*), COUNT(value_i4), MIN(value_i4), MAX(value_i4), MIN(value_i8), MAX(value_i8)
               ->  Table Scan on query_offload_aggregate_basic
                     Access Method: iceberg
(9 rows)

SELECT group_i4,
       group_i8,
       count(*) AS rows,
       count(value_i4) AS nonnull_i4,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4,
       min(value_i8) AS min_i8,
       max(value_i8) AS max_i8
FROM query_offload_aggregate_basic
GROUP BY group_i4, group_i8
ORDER BY group_i4, group_i8;
 group_i4 | group_i8 | rows | nonnull_i4 | min_i4 | max_i4 | min_i8 | max_i8 
----------+----------+------+------------+--------+--------+--------+--------
        1 |       10 |    2 |          2 |     10 |     20 |    100 |    200
        2 |       20 |    2 |          1 |    -20 |    -20 |   -200 |   -200
        2 |       30 |    1 |          1 |     30 |     30 |    300 |    300
        3 |       30 |    1 |          0 |        |        |        |       
(4 rows)

-- PostgreSQL native result.
SET lagodb.query_offload_mode = 'off';
SELECT group_i4,
       group_i8,
       count(*) AS rows,
       count(value_i4) AS nonnull_i4,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4,
       min(value_i8) AS min_i8,
       max(value_i8) AS max_i8
FROM query_offload_aggregate_basic
GROUP BY group_i4, group_i8
ORDER BY group_i4, group_i8;
 group_i4 | group_i8 | rows | nonnull_i4 | min_i4 | max_i4 | min_i8 | max_i8 
----------+----------+------+------------+--------+--------+--------+--------
        1 |       10 |    2 |          2 |     10 |     20 |    100 |    200
        2 |       20 |    2 |          1 |    -20 |    -20 |   -200 |   -200
        2 |       30 |    1 |          1 |     30 |     30 |    300 |    300
        3 |       30 |    1 |          0 |        |        |        |       
(4 rows)

-- Query offload filtered plan and result.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT group_i4,
       count(*) AS rows,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4
FROM query_offload_aggregate_basic
WHERE id >= 2
GROUP BY group_i4
ORDER BY group_i4;
                            QUERY PLAN                            
------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: group_i4 ASC NULLS LAST
         ->  Aggregate
               Group Key: group_i4
               Aggregates: COUNT(*), MIN(value_i4), MAX(value_i4)
               ->  Table Scan on query_offload_aggregate_basic
                     Access Method: iceberg
                     Filter: (id >= 2)
                     Pushed Filter: (id >= 2)
(11 rows)

SELECT group_i4,
       count(*) AS rows,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4
FROM query_offload_aggregate_basic
WHERE id >= 2
GROUP BY group_i4
ORDER BY group_i4;
 group_i4 | rows | min_i4 | max_i4 
----------+------+--------+--------
        1 |    1 |     20 |     20
        2 |    3 |    -20 |     30
        3 |    1 |        |       
(3 rows)

-- PostgreSQL native filtered result.
SET lagodb.query_offload_mode = 'off';
SELECT group_i4,
       count(*) AS rows,
       min(value_i4) AS min_i4,
       max(value_i4) AS max_i4
FROM query_offload_aggregate_basic
WHERE id >= 2
GROUP BY group_i4
ORDER BY group_i4;
 group_i4 | rows | min_i4 | max_i4 
----------+------+--------+--------
        1 |    1 |     20 |     20
        2 |    3 |    -20 |     30
        3 |    1 |        |       
(3 rows)

-- Query offload plan and result.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT group_i4, group_i8
FROM query_offload_aggregate_basic
GROUP BY group_i4, group_i8
ORDER BY group_i4, group_i8;
                             QUERY PLAN                             
--------------------------------------------------------------------
