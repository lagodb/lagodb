-- Scalar aggregate over an empty join input preserves COUNT versus nullable
-- aggregate semantics.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) AS rows,
       count(e.measure) AS values,
       min(e.measure) AS minimum,
       sum(e.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_empty AS e USING (key);
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   Execution Mode: Serial
   ->  Aggregate
         Aggregates: COUNT(*), COUNT(e.measure), MIN(e.measure), SUM(e.measure)
         ->  Hash Join
               Join Type: Inner
               Hash Cond: l.key = e.key
               ->  Table Scan on query_offload_comp_left l
                     Access Method: iceberg
               ->  Table Scan on query_offload_comp_empty e
                     Access Method: iceberg
(12 rows)

SELECT count(*) AS rows,
       count(e.measure) AS values,
       min(e.measure) AS minimum,
       sum(e.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_empty AS e USING (key);
 rows | values | minimum | total 
------+--------+---------+-------
    0 |      0 |         |      
(1 row)

