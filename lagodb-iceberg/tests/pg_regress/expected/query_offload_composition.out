       avg(r.measure)::numeric(20, 2) AS avg_right,
       count(*) FILTER (WHERE r.measure >= 300) AS large_right
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
GROUP BY l.key
HAVING count(*) >= 2
ORDER BY l.key;
