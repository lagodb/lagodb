-- A computed character(n) value keeps the width its typmod proves, and a
-- folded <> stays UNKNOWN for a NULL operand.
CREATE TABLE query_offload_comp_bpchar (
    code character(4),
    alt character(4),
    raw bpchar
) USING iceberg;
INSERT INTO query_offload_comp_bpchar VALUES
    ('ab', NULL, 'a'), (NULL, 'ab  ', 'a ');
EXPLAIN (COSTS OFF)
SELECT coalesce(code, alt) AS code_or_alt, count(*) AS rows
FROM query_offload_comp_bpchar
GROUP BY 1;
                     QUERY PLAN                      
-----------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: coalesce(code, alt)
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_comp_bpchar
               Access Method: iceberg
(7 rows)

SELECT coalesce(code, alt) AS code_or_alt, count(*) AS rows
FROM query_offload_comp_bpchar
GROUP BY 1;
 code_or_alt | rows 
-------------+------
 ab          |    2
(1 row)

EXPLAIN (COSTS OFF)
SELECT count(*) FILTER (WHERE (code <> 'abcdef') IS UNKNOWN) AS unknown_rows
FROM query_offload_comp_bpchar;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*) FILTER (WHERE ((code = code) IS UNKNOWN))
         ->  Table Scan on query_offload_comp_bpchar
               Access Method: iceberg
(6 rows)

SELECT count(*) FILTER (WHERE (code <> 'abcdef') IS UNKNOWN) AS unknown_rows
FROM query_offload_comp_bpchar;
 unknown_rows 
--------------
            1
(1 row)

-- The bpchar-to-text cast strips trailing blanks, so the unconstrained
-- bpchar values 'a' and 'a ' form one text group.
EXPLAIN (COSTS OFF)
SELECT raw::text AS raw_text, count(*) AS rows
FROM query_offload_comp_bpchar
GROUP BY 1;
                     QUERY PLAN                      
-----------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: rtrim(raw)
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_comp_bpchar
               Access Method: iceberg
(7 rows)

SELECT raw::text AS raw_text, count(*) AS rows
FROM query_offload_comp_bpchar
GROUP BY 1;
 raw_text | rows 
----------+------
 a        |    2
(1 row)

-- A constant IN list arrives as one array; an element wider than the
-- column equals no stored value and is dropped.
EXPLAIN (COSTS OFF)
SELECT count(*) FILTER (WHERE code IN ('ab', 'abcdef')) AS in_rows
FROM query_offload_comp_bpchar;
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*) FILTER (WHERE code IN (runtime value::bpchar(4)))
         ->  Table Scan on query_offload_comp_bpchar
               Access Method: iceberg
(6 rows)

SELECT count(*) FILTER (WHERE code IN ('ab', 'abcdef')) AS in_rows
FROM query_offload_comp_bpchar;
 in_rows 
---------
       1
(1 row)

DROP TABLE query_offload_comp_bpchar;
-- NAME equality and hashing (nameeq, hashname) see the bytes before the
-- terminating NUL. Unlike character(n), trailing blanks stay significant.
EXPLAIN (COSTS OFF)
SELECT a.label_name, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_name;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: a.label_name
         Aggregates: COUNT(*)
         ->  Hash Join
               Join Type: Inner
               Hash Cond: l.key = r.key
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: l.key = a.key
                     ->  Table Scan on query_offload_comp_left l
                           Access Method: iceberg
                     ->  Table Scan on query_offload_comp_aux a
                           Access Method: iceberg
               ->  Table Scan on query_offload_comp_right r
                     Access Method: iceberg
(17 rows)

SELECT a.label_name, length(a.label_name) AS label_length, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_name
ORDER BY rows;
 label_name | label_length | rows 
------------+--------------+------
 shared     |            6 |    1
 shared     |            7 |    4
(2 rows)

-- DISTINCT aggregate followed by ORDER BY and LIMIT/OFFSET.
EXPLAIN (COSTS OFF)
SELECT l.key,
       count(DISTINCT r.measure) AS distinct_values,
       max(r.measure) AS maximum,
       string_agg(r.label, ',' ORDER BY r.id) AS ordered_labels
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
WHERE l.id >= 1
GROUP BY l.key
ORDER BY maximum DESC, l.key
LIMIT 1 OFFSET 1;
                                                            QUERY PLAN                                                            
----------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Limit
         ->  Sort
               Sort Key: MAX(r.measure) DESC NULLS FIRST, l.key ASC NULLS LAST
               ->  Aggregate
                     Group Key: l.key
                     Aggregates: COUNT(DISTINCT r.measure), MAX(r.measure), STRING_AGG(r.label, ',' ORDER BY r.id ASC NULLS LAST)
                     ->  Hash Join
                           Join Type: Inner
                           Hash Cond: r.key = l.key
                           ->  Table Scan on query_offload_comp_right r
                                 Access Method: iceberg
                           ->  Table Scan on query_offload_comp_left l
                                 Access Method: iceberg
                                 Filter: (id >= 1)
                                 Pushed Filter: (id >= 1)
(17 rows)

SELECT l.key,
       count(DISTINCT r.measure) AS distinct_values,
       max(r.measure) AS maximum,
       string_agg(r.label, ',' ORDER BY r.id) AS ordered_labels
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
WHERE l.id >= 1
GROUP BY l.key
ORDER BY maximum DESC, l.key
LIMIT 1 OFFSET 1;
 key | distinct_values | maximum | ordered_labels 
-----+-----------------+---------+----------------
   1 |               1 |     100 | r1
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT l.key,
       count(DISTINCT r.measure) AS distinct_values,
       max(r.measure) AS maximum,
       string_agg(r.label, ',' ORDER BY r.id) AS ordered_labels
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
WHERE l.id >= 1
GROUP BY l.key
ORDER BY maximum DESC, l.key
LIMIT 1 OFFSET 1;
 key | distinct_values | maximum | ordered_labels 
-----+-----------------+---------+----------------
   1 |               1 |     100 | r1
(1 row)

-- ORDER BY needs measure as a resjunk input while the final output contains
-- only id. Since Sort cannot perform that target-list change, PostgreSQL creates a
-- real (dummypp=false) ProjectionPath above it. Query offload may still own the
-- scan, but it must not absorb Sort or Limit through the PostgreSQL projection.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id
FROM query_offload_comp_left
ORDER BY measure NULLS LAST, id
LIMIT 3;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Limit
   Output: id, measure
   ->  Sort
         Output: id, measure
         Sort Key: query_offload_comp_left.measure, query_offload_comp_left.id
         ->  Seq Scan on public.query_offload_comp_left
               Output: id, measure
(7 rows)

SELECT id
FROM query_offload_comp_left
ORDER BY measure NULLS LAST, id
LIMIT 3;
 id 
----
  1
  2
  4
(3 rows)

SET lagodb.query_offload_mode = 'off';
SELECT id
FROM query_offload_comp_left
ORDER BY measure NULLS LAST, id
LIMIT 3;
 id 
----
  1
  2
  4
(3 rows)

-- An unsupported non-equi join must reject the complete aggregate
-- composition instead of installing a partial query-offload fragment.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r ON l.key < r.key;
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate
   ->  Nested Loop
         Join Filter: (l.key < r.key)
         ->  Seq Scan on query_offload_comp_left l
         ->  Materialize
               ->  Seq Scan on query_offload_comp_right r
(6 rows)

SELECT count(*)
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r ON l.key < r.key;
 count 
-------
     6
(1 row)

SET lagodb.query_offload_mode = 'off';
EXPLAIN (COSTS OFF)
