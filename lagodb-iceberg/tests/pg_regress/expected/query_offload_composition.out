-- Outer-join null extension must distinguish joined rows from right values.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT l.key, count(*) AS rows, count(r.id) AS matched_right
FROM query_offload_comp_left AS l
LEFT JOIN query_offload_comp_right AS r
  ON l.key = r.key AND r.measure >= 200
WHERE r.id IS NULL OR l.id <> 2
GROUP BY l.key
ORDER BY l.key NULLS LAST;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   Execution Mode: Serial
   ->  Sort
         Sort Key: l.key ASC NULLS LAST
         ->  Aggregate
               Group Key: l.key
               Aggregates: COUNT(*), COUNT(r.id)
               ->  Filter
                     Filter: ((r.id IS NULL) OR (l.id <> runtime value))
                     ->  Hash Join
                           Join Type: Left
                           Hash Cond: l.key = r.key
                           ->  Table Scan on query_offload_comp_left l
                                 Access Method: iceberg
                           ->  Table Scan on query_offload_comp_right r
                                 Access Method: iceberg
                                 Filter: (measure >= 200)
                                 Pushed Filter: (measure >= 200)
(19 rows)

SELECT l.key, count(*) AS rows, count(r.id) AS matched_right
FROM query_offload_comp_left AS l
LEFT JOIN query_offload_comp_right AS r
  ON l.key = r.key AND r.measure >= 200
WHERE r.id IS NULL OR l.id <> 2
GROUP BY l.key
ORDER BY l.key NULLS LAST;
 key | rows | matched_right 
-----+------+---------------
   1 |    1 |             0
   2 |    2 |             2
   3 |    1 |             0
   6 |    1 |             0
     |    1 |             0
(5 rows)

