-- NOT IN needs both controls missing from the join-only fixture: an inner
-- relation containing no NULLs and an empty inner relation.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) AS not_in_nonnull
FROM query_offload_comp_left AS l
WHERE l.key NOT IN (
    SELECT a.key FROM query_offload_comp_aux AS a
);
                        QUERY PLAN                         
-----------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   Execution Mode: Serial
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Hash Join
               Join Type: Left Anti
               Hash Cond: l.key = a.key
               Null Aware: true
               ->  Table Scan on query_offload_comp_left l
                     Access Method: iceberg
               ->  Table Scan on query_offload_comp_aux a
                     Access Method: iceberg
(13 rows)

SELECT count(*) AS not_in_nonnull
FROM query_offload_comp_left AS l
WHERE l.key NOT IN (
    SELECT a.key FROM query_offload_comp_aux AS a
);
