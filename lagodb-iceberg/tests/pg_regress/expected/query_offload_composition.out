FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r ON l.key < r.key;
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate
   ->  Nested Loop
         Join Filter: (l.key < r.key)
         ->  Seq Scan on query_offload_comp_left l
         ->  Materialize
               ->  Seq Scan on query_offload_comp_right r
(6 rows)

SELECT count(*)
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r ON l.key < r.key;
