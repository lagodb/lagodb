-- A self join proves that source identity is query-local rather than keyed by
-- relation OID or display name.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   Execution Mode: Serial
   ->  Sort
         Sort Key: a.key ASC NULLS LAST
         ->  Aggregate
               Group Key: a.key
               Aggregates: COUNT(*), SUM(b.measure)
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: a.key = b.key
                     Join Filter: (a.id < b.id)
                     ->  Table Scan on query_offload_comp_left a
                           Access Method: iceberg
                     ->  Table Scan on query_offload_comp_left b
                           Access Method: iceberg
(16 rows)

SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
 key | pairs | peer_total 
-----+-------+------------
   2 |     1 |           
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
 key | pairs | peer_total 
-----+-------+------------
   2 |     1 |           
(1 row)

-- A three-source tree protects recursive join-to-aggregate composition. TEXT
-- and VARCHAR group keys also protect deterministic-collation byte equality.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.label,
       a.label_varchar,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label, a.label_varchar
ORDER BY a.label, a.label_varchar;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Sort
   Sort Key: a.label, a.label_varchar
   ->  Custom Scan (LagoDB Query Offload)
         Engine: DataFusion
         Execution Mode: Serial
         ->  Aggregate
               Group Key: a.label, a.label_varchar
               Aggregates: COUNT(*), SUM(r.measure)
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: l.key = r.key
                     ->  Hash Join
                           Join Type: Inner
                           Hash Cond: l.key = a.key
                           ->  Table Scan on query_offload_comp_left l
                                 Access Method: iceberg
                           ->  Table Scan on query_offload_comp_aux a
                                 Access Method: iceberg
                     ->  Table Scan on query_offload_comp_right r
                           Access Method: iceberg
(20 rows)

SELECT a.label,
       a.label_varchar,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label, a.label_varchar
ORDER BY a.label, a.label_varchar;
 label  | label_varchar | rows | total 
--------+---------------+------+-------
 shared | shared        |    5 |  1100
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT a.label,
       a.label_varchar,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label, a.label_varchar
ORDER BY a.label, a.label_varchar;
 label  | label_varchar | rows | total 
--------+---------------+------+-------
 shared | shared        |    5 |  1100
(1 row)

-- BPCHAR and NAME have PostgreSQL-specific equality semantics that are not part
-- of the provider-neutral hash-grouping contract. The joins may still offload,
-- but PostgreSQL must retain each Aggregate node.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.label_bpchar, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_bpchar;
                             QUERY PLAN                             
--------------------------------------------------------------------
 GroupAggregate
   Group Key: a.label_bpchar
   ->  Sort
         Sort Key: a.label_bpchar
         ->  Hash Join
               Hash Cond: (l.key = r.key)
               ->  Hash Join
                     Hash Cond: (l.key = a.key)
                     ->  Seq Scan on query_offload_comp_left l
                     ->  Hash
                           ->  Seq Scan on query_offload_comp_aux a
               ->  Hash
                     ->  Seq Scan on query_offload_comp_right r
(13 rows)

EXPLAIN (COSTS OFF)
SELECT a.label_name, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_name;
                             QUERY PLAN                             
--------------------------------------------------------------------
 GroupAggregate
   Group Key: a.label_name
   ->  Sort
         Sort Key: a.label_name
         ->  Hash Join
               Hash Cond: (l.key = r.key)
               ->  Hash Join
                     Hash Cond: (l.key = a.key)
                     ->  Seq Scan on query_offload_comp_left l
                     ->  Hash
                           ->  Seq Scan on query_offload_comp_aux a
               ->  Hash
                     ->  Seq Scan on query_offload_comp_right r
(13 rows)

-- DISTINCT aggregate followed by ORDER BY and LIMIT/OFFSET.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT l.key,
       count(DISTINCT r.measure) AS distinct_values,
       max(r.measure) AS maximum,
       string_agg(r.label, ',' ORDER BY r.id) AS ordered_labels
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
WHERE l.id >= 1
GROUP BY l.key
ORDER BY maximum DESC, l.key
LIMIT 1 OFFSET 1;
                                                            QUERY PLAN                                                            
----------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload) (actual rows=1 loops=1)
   Engine: DataFusion
   Execution Mode: Serial
   Engine Peak Memory Bytes: 7576
   ->  Limit
         ->  Sort
               Sort Key: MAX(r.measure) DESC NULLS FIRST, l.key ASC NULLS LAST
               ->  Aggregate
                     Group Key: l.key
                     Aggregates: COUNT(DISTINCT r.measure), MAX(r.measure), STRING_AGG(r.label, ',' ORDER BY r.id ASC NULLS LAST)
                     ->  Hash Join
                           Join Type: Inner
                           Hash Cond: r.key = l.key
                           ->  Table Scan on query_offload_comp_right r
                                 Access Method: iceberg
                                 Actual Input Batches: 3
                                 Actual Input Rows: 5
                                 Scan Tasks: 1
                                 Data Files Selected: 1
                                 Selected File Bytes: 1705
                           ->  Table Scan on query_offload_comp_left l
                                 Access Method: iceberg
                                 Filter: (id >= 1)
                                 Pushed Filter: (id >= 1)
                                 Actual Input Batches: 2
                                 Actual Input Rows: 4
                                 Scan Tasks: 1
                                 Data Files Selected: 1
                                 Selected File Bytes: 1329
(29 rows)

SELECT l.key,
       count(DISTINCT r.measure) AS distinct_values,
       max(r.measure) AS maximum,
       string_agg(r.label, ',' ORDER BY r.id) AS ordered_labels
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
WHERE l.id >= 1
GROUP BY l.key
ORDER BY maximum DESC, l.key
LIMIT 1 OFFSET 1;
 key | distinct_values | maximum | ordered_labels 
-----+-----------------+---------+----------------
   1 |               1 |     100 | r1
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT l.key,
