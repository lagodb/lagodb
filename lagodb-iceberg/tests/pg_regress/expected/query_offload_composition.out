-- A self join proves that source identity is query-local rather than keyed by
-- relation OID or display name.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: a.key ASC NULLS LAST
         ->  Aggregate
               Group Key: a.key
               Aggregates: COUNT(*), SUM(b.measure)
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: a.key = b.key
                     Join Filter: (a.id < b.id)
                     ->  Table Scan on query_offload_comp_left a
                           Access Method: iceberg
                     ->  Table Scan on query_offload_comp_left b
                           Access Method: iceberg
(15 rows)

SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
 key | pairs | peer_total 
-----+-------+------------
   2 |     1 |           
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT a.key, count(*) AS pairs, sum(b.measure) AS peer_total
FROM query_offload_comp_left AS a
JOIN query_offload_comp_left AS b
  ON a.key = b.key AND a.id < b.id
GROUP BY a.key
ORDER BY a.key;
 key | pairs | peer_total 
-----+-------+------------
   2 |     1 |           
(1 row)

-- A three-source tree protects recursive join-to-aggregate composition.
-- Default deterministic-collation keys cover equality; their C-collation
-- twins independently make the requested ordering byte-compatible.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.label,
       a.label_varchar,
       a.label_c,
       a.label_varchar_c,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_c, a.label_varchar_c,
         a.label, a.label_varchar
ORDER BY a.label_c, a.label_varchar_c;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: a.label_c ASC NULLS LAST, a.label_varchar_c ASC NULLS LAST
         ->  Projection
               ->  Aggregate
                     Group Key: a.label_c, a.label_varchar_c, a.label, a.label_varchar
                     Aggregates: COUNT(*), SUM(r.measure)
                     ->  Hash Join
                           Join Type: Inner
                           Hash Cond: l.key = r.key
                           ->  Hash Join
                                 Join Type: Inner
                                 Hash Cond: l.key = a.key
                                 ->  Table Scan on query_offload_comp_left l
                                       Access Method: iceberg
                                 ->  Table Scan on query_offload_comp_aux a
                                       Access Method: iceberg
                           ->  Table Scan on query_offload_comp_right r
                                 Access Method: iceberg
(20 rows)

SELECT a.label,
       a.label_varchar,
       a.label_c,
       a.label_varchar_c,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_c, a.label_varchar_c,
         a.label, a.label_varchar
ORDER BY a.label_c, a.label_varchar_c;
 label  | label_varchar | label_c | label_varchar_c | rows | total 
--------+---------------+---------+-----------------+------+-------
 shared | shared        | shared  | shared          |    5 |  1100
(1 row)

SET lagodb.query_offload_mode = 'off';
SELECT a.label,
       a.label_varchar,
       a.label_c,
       a.label_varchar_c,
       count(*) AS rows,
       sum(r.measure) AS total
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_c, a.label_varchar_c,
         a.label, a.label_varchar
ORDER BY a.label_c, a.label_varchar_c;
 label  | label_varchar | label_c | label_varchar_c | rows | total 
--------+---------------+---------+-----------------+------+-------
 shared | shared        | shared  | shared          |    5 |  1100
(1 row)

-- A declared character(n) column stores values padded to its width, so
-- bpchar equality is byte equality: 'shared' and 'shared ' form one group,
-- and a constant is padded to the width before it is compared.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT a.label_bpchar, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_bpchar;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Group Key: a.label_bpchar
         Aggregates: COUNT(*)
         ->  Hash Join
               Join Type: Inner
               Hash Cond: l.key = r.key
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: l.key = a.key
                     ->  Table Scan on query_offload_comp_left l
                           Access Method: iceberg
                     ->  Table Scan on query_offload_comp_aux a
                           Access Method: iceberg
               ->  Table Scan on query_offload_comp_right r
                     Access Method: iceberg
(17 rows)

SELECT a.label_bpchar, count(*) AS rows
FROM query_offload_comp_left AS l
JOIN query_offload_comp_right AS r USING (key)
JOIN query_offload_comp_aux AS a USING (key)
GROUP BY a.label_bpchar;
 label_bpchar | rows 
--------------+------
 shared       |    5
(1 row)

EXPLAIN (COSTS OFF)
SELECT count(*) AS rows
FROM query_offload_comp_aux
WHERE label_bpchar = 'shared';
                           QUERY PLAN                           
----------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_comp_aux
               Access Method: iceberg
               Filter: (label_bpchar = 'shared'::bpchar)
               Pushed Filter: (label_bpchar = 'shared'::bpchar)
(8 rows)

SELECT count(*) AS rows
FROM query_offload_comp_aux
WHERE label_bpchar = 'shared';
 rows 
------
    2
(1 row)

