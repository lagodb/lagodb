-- A limited ordered inner join exercises parallel join distribution and
-- early output termination without routing through an aggregate.
SET lagodb.query_offload_mode = 'force';
SELECT pg_temp.explain_analyze_text($$
SELECT l.id AS left_id, r.id AS right_id, l.key
FROM query_offload_parallel_left AS l
JOIN query_offload_parallel_right AS r USING (key)
ORDER BY left_id, right_id
LIMIT 8
$$, mask_local_memory => true);
                               explain_analyze_text                               
----------------------------------------------------------------------------------
 Limit (actual rows=N loops=N)
   ->  Sort (actual rows=N loops=N)
         Sort Key: l.id, r.id
         Sort Method: top-N heapsort  Memory: 25kB
         ->  Result (actual rows=N loops=N)
               ->  Custom Scan (LagoDB Query Offload) (actual rows=N loops=N)
                     Engine: DataFusion
                     Execution Mode: Parallel
                     Maximum Launched Workers: 2
                     Parallel Runs: 1
                     Maximum Worker Fragment Peak Memory Bytes: N
                     Maximum Worker Participant Peak Memory Bytes: N
                     Local Engine Peak Memory Bytes: N
                     ->  Projection
                           ->  Hash Join
                                 Join Type: Inner
                                 Hash Cond: l.key = r.key
                                 ->  Table Scan on query_offload_parallel_left l
                                       Access Method: iceberg
                                       Actual Input Batches: 33
                                       Actual Input Rows: 33
                                       Scan Tasks: 33
                                       Data Files Selected: 33
                                       Selected File Bytes: 53886
                                 ->  Table Scan on query_offload_parallel_right r
                                       Access Method: iceberg
                                       Actual Input Batches: 17
                                       Actual Input Rows: 33
                                       Scan Tasks: 1
                                       Data Files Selected: 1
                                       Selected File Bytes: 1513
(31 rows)

