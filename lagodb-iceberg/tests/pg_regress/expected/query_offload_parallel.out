-- PostgreSQL worker budget below two producers also negotiates serial mode.
SET max_parallel_workers_per_gather = 0;
SELECT pg_temp.explain_analyze_text($$
SELECT key, count(*)
FROM query_offload_parallel_left
GROUP BY key
$$);
