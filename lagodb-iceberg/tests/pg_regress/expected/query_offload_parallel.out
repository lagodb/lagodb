-- query_offload_parallel.sql
-- Leader-owned PostgreSQL-worker execution for query-offload plans. Operator
-- semantics remain in the focused aggregate/join/composition suites; this file
-- protects parallel admission, representative query shapes, and observability.
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
CREATE EXTENSION IF NOT EXISTS lagodb_iceberg;
SET lagodb.customscan_mode = 'off';
SET lagodb.query_offload_mode = 'force';
SET lagodb.query_batch_rows = 2;
SET lagodb.query_offload_parallel_min_scan_rows = 0;
SET max_parallel_workers_per_gather = 2;
SELECT current_setting('lagodb.query_offload_parallel_min_scan_rows')::integer = 0
           AS size_gate_disabled;
 size_gate_disabled 
--------------------
 t
(1 row)

CREATE TABLE query_offload_parallel_left (
    id integer,
    key integer,
    value integer,
    label text
) USING iceberg;
CREATE TABLE query_offload_parallel_right (
    id integer,
    key integer,
    value integer
) USING iceberg;
CREATE TABLE query_offload_parallel_small (
    id integer,
    key integer,
    value integer
) USING iceberg;
-- Iceberg's default split weighting charges one 4 MiB open cost per data file
-- and targets 128 MiB groups. Thirty-three separately written files therefore
-- form at least two source work groups without creating a large data fixture.
-- \gexec preserves those statement/file boundaries; one INSERT ... SELECT
-- would put all rows through a single DML session.
\set ECHO none
INSERT INTO query_offload_parallel_right
SELECT 100 + row_id, row_id % 4, row_id * 100
FROM generate_series(1, 33) AS row_id;
INSERT INTO query_offload_parallel_small VALUES (1, 1, 10);
\i include/explain_analyze_text.sql
-- Text EXPLAIN ANALYZE with PostgreSQL's regression options. PostgreSQL row
-- counts are masked as in partition_prune.sql because their text format
-- differs across major versions. LagoDB worker peak memory depends on how
-- producer batches interleave in each worker, so it is masked as
-- select_parallel.sql masks parallel sort memory. A caller can opt into the
-- same treatment for a leader network-boundary peak while retaining the
-- invariant that the peak is nonzero. Other LagoDB metrics are left unchanged.
-- LagoDB duration properties ("N ms") are masked as explain.sql masks them,
-- but PostgreSQL's per-node actual time is not, so callers that request timing
-- select only the properties they assert.
CREATE FUNCTION pg_temp.explain_analyze_text(
    query text,
    verbose_plan boolean DEFAULT false,
    timing boolean DEFAULT false,
    mask_local_memory boolean DEFAULT false
) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
    ln text;
BEGIN
    FOR ln IN
        EXECUTE format(
            'EXPLAIN (ANALYZE, VERBOSE %s, COSTS OFF, TIMING %s, SUMMARY OFF, BUFFERS OFF) %s',
            verbose_plan::text, timing::text, query)
    LOOP
        ln := regexp_replace(ln, 'actual rows=\d+(?:\.\d+)? loops=\d+',
                             'actual rows=N loops=N');
        ln := regexp_replace(ln, '(Worker \w+ Peak Memory Bytes): \d+', '\1: N');
        IF mask_local_memory THEN
            ln := regexp_replace(
                ln,
                '(Local Engine Peak Memory Bytes): [1-9][0-9]*',
                '\1: N');
        END IF;
        ln := regexp_replace(ln, '\d+\.\d+ ms', 'N ms', 'g');
        RETURN NEXT ln;
    END LOOP;
END;
$$;
-- A one-file source has no distributable stage and negotiates serial execution
-- before any worker starts.
SELECT pg_temp.explain_analyze_text($$
SELECT key, count(*)
FROM query_offload_parallel_small
GROUP BY key
$$);
                    explain_analyze_text                    
------------------------------------------------------------
 Custom Scan (LagoDB Query Offload) (actual rows=N loops=N)
   Engine: DataFusion
   Execution Mode: Serial
   Local Engine Peak Memory Bytes: 4164
   ->  Aggregate
         Group Key: key
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_parallel_small
               Access Method: iceberg
               Actual Input Batches: 1
               Actual Input Rows: 1
               Scan Tasks: 1
               Data Files Selected: 1
               Selected File Bytes: 1265
(14 rows)

-- The planner-row threshold is an admission gate, not an execution fallback.
SET lagodb.query_offload_parallel_min_scan_rows = 2147483647;
SELECT pg_temp.explain_analyze_text($$
SELECT key, count(*)
FROM query_offload_parallel_left
GROUP BY key
