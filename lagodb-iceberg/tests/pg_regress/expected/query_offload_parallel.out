SET max_parallel_workers_per_gather = 2;
-- A filtered grouped aggregate consumes every source work group exactly
-- once. ANALYZE metrics prove that a parallel run was launched and completely
-- reported, while the result is compared with PostgreSQL's native execution.
SELECT pg_temp.explain_analyze_text($$
SELECT key,
       count(*) AS rows,
       count(value) AS nonnull_values,
       sum(value) AS total
FROM query_offload_parallel_left
WHERE id >= 1
GROUP BY key
ORDER BY key
$$);
                     explain_analyze_text                     
--------------------------------------------------------------
 Custom Scan (LagoDB Query Offload) (actual rows=N loops=N)
   Engine: DataFusion
   Execution Mode: Parallel
   Maximum Launched Workers: 2
   Parallel Runs: 1
   Maximum Worker Fragment Peak Memory Bytes: N
   Maximum Worker Participant Peak Memory Bytes: N
   Local Engine Peak Memory Bytes: 3072
   ->  Sort
         Sort Key: key ASC NULLS LAST
         ->  Aggregate
               Group Key: key
               Aggregates: COUNT(*), COUNT(value), SUM(value)
               ->  Table Scan on query_offload_parallel_left
                     Access Method: iceberg
                     Filter: (id >= 1)
                     Pushed Filter: (id >= 1)
                     Actual Input Batches: 33
                     Actual Input Rows: 33
                     Scan Tasks: 33
                     Data Files Selected: 33
                     Selected File Bytes: 53886
(22 rows)

-- With timing, a launched parallel run also reports its startup time.
SELECT ln FROM pg_temp.explain_analyze_text($$
SELECT key, count(*) FROM query_offload_parallel_left GROUP BY key
$$, timing => true) AS ln
WHERE ln ~ 'Startup Time';
              ln               
-------------------------------
   Parallel Startup Time: N ms
(1 row)

