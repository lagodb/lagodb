-- Aggregate-over-inner-join reuses the same parallel execution framework
-- and preserves duplicate fanout, NULL aggregate inputs, FILTER, and HAVING.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT l.key,
       count(*) AS joined_rows,
       count(l.value) AS nonnull_left,
       sum(r.value) FILTER (WHERE r.id >= 120) AS filtered_total
FROM query_offload_parallel_left AS l
JOIN query_offload_parallel_right AS r USING (key)
GROUP BY l.key
HAVING count(*) > 60
ORDER BY l.key;
                                                  QUERY PLAN                                                   
---------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload) (actual rows=4 loops=1)
   Engine: DataFusion
   Execution Mode: Parallel
   Maximum Launched Workers: 2
   Parallel Runs: 1
   Worker Metric Reports: 5
   Expected Worker Metric Reports: 5
   Maximum Worker Fragment Peak Memory Bytes: 5348
   Maximum Worker Participant Peak Memory Bytes: 5348
   Local Engine Peak Memory Bytes: 3072
   ->  Sort
         Sort Key: l.key ASC NULLS LAST
         ->  Filter
               Filter: ((COUNT(*) > runtime value))
               ->  Aggregate
                     Group Key: l.key
                     Aggregates: COUNT(*), COUNT(l.value), SUM(r.value) FILTER (WHERE (r.id >= runtime value))
                     ->  Hash Join
                           Join Type: Inner
                           Hash Cond: l.key = r.key
                           ->  Table Scan on query_offload_parallel_left l
                                 Access Method: iceberg
                                 Actual Input Batches: 33
                                 Actual Input Rows: 33
                                 Scan Tasks: 33
                                 Data Files Selected: 33
                                 Selected File Bytes: 41523
                           ->  Table Scan on query_offload_parallel_right r
                                 Access Method: iceberg
                                 Actual Input Batches: 17
                                 Actual Input Rows: 33
                                 Scan Tasks: 1
                                 Data Files Selected: 1
                                 Selected File Bytes: 1513
(34 rows)

SELECT l.key,
       count(*) AS joined_rows,
       count(l.value) AS nonnull_left,
       sum(r.value) FILTER (WHERE r.id >= 120) AS filtered_total
FROM query_offload_parallel_left AS l
JOIN query_offload_parallel_right AS r USING (key)
GROUP BY l.key
HAVING count(*) > 60
ORDER BY l.key;
