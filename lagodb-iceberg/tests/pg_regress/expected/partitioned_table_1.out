DROP ROLE partitioned_copy_user;
-- Managed Iceberg partitioned table INSERT, UPDATE, DELETE, MERGE, and COPY.
CREATE SCHEMA dml_lifecycle;
CREATE TABLE dml_lifecycle.part_t (
    id integer,
    region text,
    label text
) PARTITION BY LIST (region) USING iceberg;
SELECT relkind = 'r' AND NOT relhassubclass AS partitioned_table_catalog_shape,
       pg_get_partkeydef(oid) IS NULL AS pg_partition_key_hidden
FROM pg_class
WHERE oid = 'dml_lifecycle.part_t'::regclass;
 partitioned_table_catalog_shape | pg_partition_key_hidden 
---------------------------------+-------------------------
 t                               | t
(1 row)

-- COPY FROM writes the table directly; PostgreSQL has no child partitions to
-- route to.
COPY dml_lifecycle.part_t FROM stdin WITH (FORMAT csv);
INSERT INTO dml_lifecycle.part_t VALUES (40, 'west', 'd');
UPDATE dml_lifecycle.part_t
SET label = label || '_u'
WHERE id IN (10, 20) AND EXISTS (SELECT 1);
-- Moving an Iceberg identity partition value remains one logical-table
-- update; it must not ask PostgreSQL for a destination child partition.
UPDATE dml_lifecycle.part_t SET region = 'west' WHERE id = 10;
DELETE FROM dml_lifecycle.part_t WHERE id = 30;
SELECT id, region, label,
       tableoid = 'dml_lifecycle.part_t'::regclass AS partitioned_tableoid
FROM dml_lifecycle.part_t
ORDER BY id;
 id | region | label | partitioned_tableoid 
----+--------+-------+----------------------
 10 | west   | a_u   | t
 20 | west   | b_u   | t
 40 | west   | d     | t
(3 rows)

SELECT count(*) = 3 AS only_partitioned_table_reads_data
FROM ONLY dml_lifecycle.part_t;
 only_partitioned_table_reads_data 
-----------------------------------
 t
(1 row)

MERGE INTO dml_lifecycle.part_t AS target
USING (VALUES
    (20, 'east', 'merged'),
    (40, 'west', 'delete'),
    (50, 'east', 'new')
) AS source(id, region, label)
ON target.id = source.id
WHEN MATCHED AND source.label = 'delete' THEN DELETE
WHEN MATCHED THEN
    UPDATE SET region = source.region, label = source.label
WHEN NOT MATCHED THEN
    INSERT (id, region, label)
    VALUES (source.id, source.region, source.label);
SELECT id, region, label FROM dml_lifecycle.part_t ORDER BY id;
 id | region | label  
----+--------+--------
 10 | west   | a_u
 20 | east   | merged
 50 | east   | new
(3 rows)

BEGIN;
INSERT INTO dml_lifecycle.part_t VALUES (60, 'west', 'tx');
UPDATE dml_lifecycle.part_t SET label = 'tx-updated' WHERE id = 20;
DELETE FROM dml_lifecycle.part_t WHERE id = 10;
SELECT count(*) = 3 AS transaction_delta_visible
FROM dml_lifecycle.part_t;
 transaction_delta_visible 
---------------------------
 t
(1 row)

ROLLBACK;
SELECT id, region, label FROM dml_lifecycle.part_t ORDER BY id;
 id | region | label  
----+--------+--------
 10 | west   | a_u
 20 | east   | merged
 50 | east   | new
(3 rows)

-- Partition-aware v3 deletion vectors use a different delete-file path from v2.
CREATE TABLE dml_lifecycle.part_v3 (
    id integer,
    region text,
    label text
) PARTITION BY LIST (region) USING iceberg WITH ("format-version" = 3);
INSERT INTO dml_lifecycle.part_v3
VALUES (1, 'east', 'one'), (2, 'west', 'two'), (3, 'east', 'three');
UPDATE dml_lifecycle.part_v3 SET region = 'west', label = 'moved' WHERE id = 1;
DELETE FROM dml_lifecycle.part_v3 WHERE id = 2;
SELECT id, region, label FROM dml_lifecycle.part_v3 ORDER BY id;
 id | region | label 
----+--------+-------
  1 | west   | moved
  3 | east   | three
(2 rows)

-- A composite partition Struct stays intact through row movement, deletion
-- vectors, MERGE, and TRUNCATE.
CREATE TABLE dml_lifecycle.composite_v3 (
    id integer,
    event_time timestamp,
    region text,
    label text
) PARTITION BY LIST (region, date_trunc('day', event_time), iceberg.bucket(4, id))
USING iceberg WITH ("format-version" = 3);
INSERT INTO dml_lifecycle.composite_v3 VALUES
    (1, '2026-01-01 10:00:00', 'east', 'one'),
    (2, '2026-01-01 11:00:00', 'east', 'two'),
    (3, '2026-01-02 10:00:00', 'west', 'three'),
    (4, NULL, 'west', 'four');
UPDATE dml_lifecycle.composite_v3
SET event_time = '2026-01-03 00:00:00', region = 'west' WHERE id = 1;
DELETE FROM dml_lifecycle.composite_v3 WHERE id = 2;
MERGE INTO dml_lifecycle.composite_v3 AS target
USING (VALUES (3, 'merged'), (4, 'delete'), (5, 'new')) AS source(id, label)
ON target.id = source.id
WHEN MATCHED AND source.label = 'delete' THEN DELETE
WHEN MATCHED THEN UPDATE SET label = source.label
WHEN NOT MATCHED THEN
    INSERT (id, event_time, region, label)
    VALUES (source.id, '2026-01-04 00:00:00', 'east', source.label);
SELECT id, to_char(event_time, 'YYYY-MM-DD') AS event_day, region, label
FROM dml_lifecycle.composite_v3 ORDER BY id;
 id | event_day  | region | label  
----+------------+--------+--------
  1 | 2026-01-03 | west   | one
  3 | 2026-01-02 | west   | merged
  5 | 2026-01-04 | east   | new
(3 rows)

TRUNCATE dml_lifecycle.composite_v3;
INSERT INTO dml_lifecycle.composite_v3
VALUES (6, '2026-01-05 00:00:00', 'east', 'after');
SELECT id, label FROM dml_lifecycle.composite_v3;
 id | label 
----+-------
  6 | after
(1 row)

SELECT string_agg(field.spec->>'name', ', ' ORDER BY field.ordinal) AS partition_fields
FROM iceberg.iceberg_metadata
CROSS JOIN LATERAL (SELECT pg_read_file(metadata_location)::jsonb AS metadata) AS file
CROSS JOIN LATERAL jsonb_array_elements(metadata->'partition-specs'->0->'fields')
    WITH ORDINALITY AS field(spec, ordinal)
WHERE relid = 'dml_lifecycle.composite_v3'::regclass;
          partition_fields           
-------------------------------------
 region, event_time_day, id_bucket_4
(1 row)

SET client_min_messages = warning;
DROP SCHEMA dml_lifecycle CASCADE;
RESET client_min_messages;
