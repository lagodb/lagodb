-- transaction_resources.sql
-- Tests the lifecycle of transaction-scoped storage resources on local tablespaces.
-- Verifies that abort cleans up data files and savepoint semantics work.
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
CREATE EXTENSION lagodb_iceberg;
CREATE SCHEMA transaction_resources;
--
-- Test 1: Local DML abort deletes new data files
--
-- After a rolled-back INSERT, newly created data files must be removed.
CREATE TABLE transaction_resources.abort_insert (id integer) USING iceberg;
SELECT pg_relation_filepath('transaction_resources.abort_insert') || '_iceberg' AS tbl_dir \gset
-- Verify table dir exists but data dir has no parquet files yet
\! find :"tbl_dir" -name '*.parquet' 2>/dev/null | wc -l | tr -d ' '
0
BEGIN;
INSERT INTO transaction_resources.abort_insert SELECT g FROM generate_series(1, 100) AS g;
ROLLBACK;
-- After ROLLBACK, data files must be cleaned up
\! find :"tbl_dir" -name '*.parquet' 2>/dev/null | wc -l | tr -d ' '
0
-- Table should have zero rows
SELECT count(*) AS rows_after_abort FROM transaction_resources.abort_insert;
 rows_after_abort 
------------------
                0
(1 row)

--
-- Test 2: Committed INSERT preserves data files
--
INSERT INTO transaction_resources.abort_insert SELECT g FROM generate_series(1, 10) AS g;
SELECT count(*) AS rows_after_commit FROM transaction_resources.abort_insert;
 rows_after_commit 
-------------------
                10
(1 row)

--
-- Test 3: Savepoint rollback cleans only sub-transaction files
--
CREATE TABLE transaction_resources.savepoint_cleanup (id integer) USING iceberg;
BEGIN;
-- Outer INSERT (nest level 1)
INSERT INTO transaction_resources.savepoint_cleanup VALUES (1), (2), (3);
SAVEPOINT s1;
-- Inner INSERT (nest level 2)
INSERT INTO transaction_resources.savepoint_cleanup VALUES (10), (20), (30);
-- Rollback inner savepoint - inner data files should be cleaned
ROLLBACK TO SAVEPOINT s1;
-- Commit outer
COMMIT;
-- Only outer rows survive
SELECT count(*) AS rows_after_partial_rollback FROM transaction_resources.savepoint_cleanup;
 rows_after_partial_rollback 
-----------------------------
                           3
(1 row)

SELECT * FROM transaction_resources.savepoint_cleanup ORDER BY id;
 id 
----
  1
  2
  3
(3 rows)

--
-- Test 4: Savepoint release + outer abort cleans all merged entries
--
CREATE TABLE transaction_resources.release_abort (id integer) USING iceberg;
SELECT pg_relation_filepath('transaction_resources.release_abort') || '_iceberg' AS ra_dir \gset
BEGIN;
SAVEPOINT s2;
INSERT INTO transaction_resources.release_abort VALUES (100), (200);
-- Release promotes subtransaction resources to the parent
RELEASE SAVEPOINT s2;
-- Outer abort should clean all resources, including promoted resources
ROLLBACK;
-- Zero rows, data files cleaned
SELECT count(*) AS rows_after_release_abort FROM transaction_resources.release_abort;
 rows_after_release_abort 
--------------------------
                        0
(1 row)

\! find :"ra_dir" -name '*.parquet' 2>/dev/null | wc -l | tr -d ' '
0
--
-- Test 5: Nested savepoints - only innermost is cleaned on rollback
--
CREATE TABLE transaction_resources.nested_sp (id integer) USING iceberg;
BEGIN;
INSERT INTO transaction_resources.nested_sp VALUES (1);
SAVEPOINT sp_outer;
INSERT INTO transaction_resources.nested_sp VALUES (2);
SAVEPOINT sp_inner;
INSERT INTO transaction_resources.nested_sp VALUES (3);
-- Rollback only the innermost
ROLLBACK TO SAVEPOINT sp_inner;
-- Row 3 is gone, rows 1 and 2 survive
INSERT INTO transaction_resources.nested_sp VALUES (4);
COMMIT;
SELECT * FROM transaction_resources.nested_sp ORDER BY id;
 id 
----
  1
  2
  4
(3 rows)

SET client_min_messages = warning;
DROP SCHEMA transaction_resources CASCADE;
RESET client_min_messages;
