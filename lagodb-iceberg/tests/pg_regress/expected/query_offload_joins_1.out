DROP TABLE query_offload_join_aux;
DROP TABLE query_offload_join_right;
DROP TABLE query_offload_join_left;
RESET timezone;
RESET lagodb.query_batch_rows;
RESET lagodb.query_offload_mode;
RESET lagodb.customscan_mode;
