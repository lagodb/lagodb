-- EXISTS stops each rescan after one row, abandoning the running inner
-- stream before the next outer value rebuilds the plan.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT l.id
FROM query_offload_join_left AS l
WHERE EXISTS (
    SELECT 1
    FROM query_offload_join_right AS r
    JOIN query_offload_join_aux AS a USING (key_i4)
    WHERE r.key_i8 = l.key_i8
    OFFSET 0
)
ORDER BY l.id;
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Sort
   Sort Key: l.id
   ->  Seq Scan on query_offload_join_left l
         Filter: EXISTS(SubPlan 1)
         SubPlan 1
           ->  Result
                 ->  Custom Scan (LagoDB Query Offload)
                       Engine: DataFusion
                       ->  Projection
                             ->  Hash Join
                                   Join Type: Inner
                                   Hash Cond: r.key_i4 = a.key_i4
                                   ->  Table Scan on query_offload_join_right r
                                         Access Method: iceberg
                                         Filter: (key_i8 = $1)
                                   ->  Table Scan on query_offload_join_aux a
                                         Access Method: iceberg
(17 rows)

