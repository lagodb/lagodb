EXPLAIN (COSTS OFF)
SELECT s.id
FROM query_offload_join_scalar AS s
WHERE s.__lagodb_output_0 <= (
    SELECT 0.5 * sum(r.key_numeric)
    FROM query_offload_join_right AS r
    WHERE r.key_i4 = s.key_i4 AND random() >= 0
)
ORDER BY s.id;
                                        QUERY PLAN                                         
-------------------------------------------------------------------------------------------
 Sort
   Sort Key: s.id
   ->  Seq Scan on query_offload_join_scalar s
         Filter: (__lagodb_output_0 <= (SubPlan 1))
         SubPlan 1
           ->  Custom Scan (LagoDB Query Offload)
                 Engine: DataFusion
                 PostgreSQL Expression Fallbacks: 1
                 ->  Aggregate
                       Aggregates: SUM(key_numeric)
                       ->  Table Scan on query_offload_join_right r
                             Access Method: iceberg
                             Filter: (random() >= '0'::double precision) AND (key_i4 = $2)
(13 rows)

DROP TABLE query_offload_join_scalar;
-- ============================================================================
-- Negative capability gates: forcing query offload cannot bypass an
-- unsupported timestamp equality key or invent an equi key for a non-equi
-- join. Both plans and results must remain PostgreSQL-native.
-- ============================================================================
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT l.id AS left_id, r.id AS right_id
FROM query_offload_join_left AS l
JOIN query_offload_join_right AS r
  ON l.key_timestamp = r.key_timestamp
ORDER BY left_id, right_id;
                        QUERY PLAN                        
----------------------------------------------------------
 Sort
   Sort Key: l.id, r.id
   ->  Hash Join
         Hash Cond: (l.key_timestamp = r.key_timestamp)
         ->  Seq Scan on query_offload_join_left l
         ->  Hash
               ->  Seq Scan on query_offload_join_right r
(7 rows)

