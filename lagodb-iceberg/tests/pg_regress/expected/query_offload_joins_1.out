-- Float join keys run in the engine: DataFusion folds -0 into +0 and keeps
-- NaN payloads apart. Both inputs store PostgreSQL's canonical NaN, so the
-- offload result matches PostgreSQL; see docs/query-offload-semantics.md.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT count(*) AS matches
FROM query_offload_join_left AS l
JOIN query_offload_join_right AS r
  ON l.key_f4 = r.key_f4
 AND l.key_f8 = r.key_f8;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Hash Join
               Join Type: Inner
               Hash Cond: l.key_f4 = r.key_f4 AND l.key_f8 = r.key_f8
               ->  Table Scan on query_offload_join_left l
                     Access Method: iceberg
               ->  Table Scan on query_offload_join_right r
                     Access Method: iceberg
(11 rows)

