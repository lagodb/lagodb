-- The comparison reads both join inputs, so it filters the inner join.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT l.id AS left_id, r.id AS right_id
FROM query_offload_join_left AS l
JOIN query_offload_join_right AS r ON l.key_i4 = r.key_i4
WHERE l.key_numeric * l.id < (
    SELECT 2.5 * avg(r2.key_numeric)
    FROM query_offload_join_right AS r2
    WHERE r2.key_i4 = r.key_i4
)
ORDER BY left_id, right_id;
                                                          QUERY PLAN                                                           
-------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: l.id ASC NULLS LAST, r.id ASC NULLS LAST
         ->  Projection
               ->  Filter
                     Filter: ((l.key_numeric * (l.id)::decimal(10, 0)) < (runtime value::decimal(2, 1) * AVG(r2.key_numeric)))
                     ->  Hash Join
                           Join Type: Left
                           Hash Cond: r.key_i4 = r2.key_i4
                           ->  Hash Join
                                 Join Type: Inner
                                 Hash Cond: l.key_i4 = r.key_i4
                                 ->  Table Scan on query_offload_join_left l
                                       Access Method: iceberg
                                 ->  Table Scan on query_offload_join_right r
                                       Access Method: iceberg
                           ->  Aggregate
                                 Group Key: r2.key_i4
                                 Aggregates: AVG(r2.key_numeric)
                                 ->  Table Scan on query_offload_join_right r2
                                       Access Method: iceberg
(22 rows)

