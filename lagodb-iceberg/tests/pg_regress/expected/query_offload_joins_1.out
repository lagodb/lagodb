FROM query_offload_join_scalar AS s
WHERE s.__lagodb_output_0 <= (
    SELECT 0.5 * sum(r.key_numeric)
    FROM query_offload_join_right AS r
    WHERE r.key_i4 = s.key_i4
)
ORDER BY s.id;
