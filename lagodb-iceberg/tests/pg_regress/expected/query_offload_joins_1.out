-- COUNT over no rows is 0, not NULL, and a volatile subquery is evaluated
-- per outer row; both stay PostgreSQL SubPlans.
SET lagodb.query_offload_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT l.id
FROM query_offload_join_left AS l
WHERE l.measure > (
    SELECT count(*)
    FROM query_offload_join_right AS r
    WHERE r.key_i4 = l.key_i4
)
ORDER BY l.id;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Sort
   Sort Key: l.id
   ->  Seq Scan on query_offload_join_left l
         Filter: (measure > (SubPlan 1))
         SubPlan 1
           ->  Custom Scan (LagoDB Query Offload)
                 Engine: DataFusion
                 ->  Aggregate
                       Aggregates: COUNT(*)
                       ->  Table Scan on query_offload_join_right r
                             Access Method: iceberg
                             Filter: (key_i4 = $1)
(12 rows)

