-- Provision the object-storage fixture used by object-backed pg_regress tests.
-- pg_regress unsets PGDATABASE and passes the database only via psql -d, so
-- export it for the fixture's own psql calls. `\!` does not interpolate psql
-- variables (OT_WHOLE_LINE), but `\setenv` arguments (OT_NORMAL) do.
\setenv PGDATABASE :DBNAME
\! python3 ../../../scripts/pg_regress/regress_fixture.py setup --iceberg
object_storage_setup: true
\i ../../../scripts/pg_regress/fixture_command_result.sql
-- psql's \! records an ordinary nonzero exit in SHELL_ERROR and keeps running.
-- Include with \i from the suite root: pg_regress feeds top-level SQL via stdin.
-- Only failed infrastructure commands enable ON_ERROR_STOP; expected SQL errors
-- in the actual regression cases retain their normal pg_regress behavior.
\if :SHELL_ERROR
\set ON_ERROR_STOP on
DO $$ BEGIN RAISE EXCEPTION 'Regression fixture command failed'; END $$;
\endif
-- Install the shared LagoDB services once for the regression database.
-- Individual AM tests may drop/recreate lagodb_iceberg, but the base-owned
-- maintenance queue and database-local worker registration must survive.
CREATE EXTENSION lagodb_base;
SELECT extname
FROM pg_extension
WHERE extname = 'lagodb_base';
   extname   
-------------
 lagodb_base
(1 row)

-- Recover a storage singleton paused by an interrupted worker cancellation
-- test. The PID is resolved afresh; the guard never trusts an old stored PID.
SET client_min_messages = warning;
SELECT pid::text AS lagodb_regress_storage_pid
FROM pg_stat_activity
WHERE backend_type = 'lagodb-storage'
\gset
SELECT current_setting('port') || '-' || current_database()
       AS lagodb_regress_slot
\gset
\setenv LAGODB_REGRESS_STORAGE_PID :lagodb_regress_storage_pid
\setenv LAGODB_REGRESS_SLOT :lagodb_regress_slot
\! bin/storage_worker_pause_guard recover
-- Remove a cluster-wide injection attachment left by an interrupted worker
-- lifecycle test before any ordinary regression test can wake that worker.
CREATE EXTENSION IF NOT EXISTS injection_points;
DO $$
BEGIN
    PERFORM injection_points_detach(
        'lagodb-worker-after-database-connection'
    );
EXCEPTION WHEN internal_error THEN
    IF SQLERRM <>
       'could not detach injection point "lagodb-worker-after-database-connection"'
    THEN
        RAISE;
    END IF;
END
$$;
DROP EXTENSION injection_points;
DROP DATABASE IF EXISTS lagodb_runtime_source WITH (FORCE);
DROP ROLE IF EXISTS lagodb_runtime_non_superuser;
-- Remove durable cancellation fixtures left by an interrupted run.
DELETE FROM lagodb.maintenance_queue
WHERE item_id = '00000000-0000-0000-0000-000000000004';
-- Discard only the state-dependent cleanup result; assert the postcondition.
SELECT lagodb.drop_storage_volume(storage_volume_name)
FROM lagodb.storage_volumes
WHERE storage_volume_name =
      'regress-worker-statement-cancel-' || current_database()
\g /dev/null
SELECT NOT EXISTS (
    SELECT FROM lagodb.storage_volumes
    WHERE storage_volume_name =
          'regress-worker-statement-cancel-' || current_database()
) AS worker_cancel_cleanup_completed;
 worker_cancel_cleanup_completed 
---------------------------------
 t
(1 row)

RESET client_min_messages;
\! python3 ../../../scripts/pg_regress/regress_fixture.py wait-storage
storage_service_ready: true
\i ../../../scripts/pg_regress/fixture_command_result.sql
-- psql's \! records an ordinary nonzero exit in SHELL_ERROR and keeps running.
-- Include with \i from the suite root: pg_regress feeds top-level SQL via stdin.
-- Only failed infrastructure commands enable ON_ERROR_STOP; expected SQL errors
-- in the actual regression cases retain their normal pg_regress behavior.
\if :SHELL_ERROR
\set ON_ERROR_STOP on
DO $$ BEGIN RAISE EXCEPTION 'Regression fixture command failed'; END $$;
\endif
-- LagoDB setup complete.
