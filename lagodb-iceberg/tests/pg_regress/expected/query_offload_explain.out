-- query_offload_explain.sql
-- Stable user-facing and structured EXPLAIN contract.
DROP EXTENSION IF EXISTS lagodb_iceberg CASCADE;
CREATE EXTENSION IF NOT EXISTS lagodb_iceberg;
SET lagodb.query_batch_rows = 2;
SET lagodb.customscan_mode = 'off';
SET lagodb.query_offload_mode = 'force';
CREATE TABLE query_offload_explain_left (
    id integer,
    key integer,
    value integer
) USING iceberg;
CREATE TABLE query_offload_explain_right (
    key integer,
    value integer
) USING iceberg;
INSERT INTO query_offload_explain_left VALUES
    (1, 1, 10),
    (2, 2, 20),
    (3, 2, 30);
INSERT INTO query_offload_explain_right VALUES
    (1, 100),
    (2, 200);
CREATE FUNCTION query_offload_explain_json(options text, query text)
RETURNS jsonb
LANGUAGE plpgsql AS $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE format('EXPLAIN (%s, FORMAT JSON) %s', options, query) INTO plan;
    RETURN plan;
END;
$$;
-- Default output is one logical tree without configuration, internal IDs, or
-- projection details. COSTS OFF removes every provider estimate.
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM query_offload_explain_left
WHERE id = 1;
                      QUERY PLAN                      
------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_explain_left
               Access Method: iceberg
               Filter: (id = 1)
               Pushed Filter: (id = 1)
(8 rows)

-- Provider estimates are attached to the corresponding scan only when costs
-- are requested. Provider cost components remain VERBOSE diagnostics.
EXPLAIN (COSTS ON)
SELECT count(*)
FROM query_offload_explain_left
WHERE id = 1;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)  (cost=0.00..1.00 rows=1 width=8)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Table Scan on query_offload_explain_left
               Access Method: iceberg
               Estimated Rows Read: 1
               Estimated Bytes Read: 2731 bytes
               Filter: (id = 1)
               Pushed Filter: (id = 1)
(10 rows)

EXPLAIN (VERBOSE, COSTS ON)
SELECT count(*)
FROM query_offload_explain_left
WHERE id = 1;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)  (cost=0.00..1.00 rows=1 width=8)
   Output: (count(*))
   Engine: DataFusion
   Maximum Batch Rows: 2
   ->  Projection
         Output: COUNT(*)
         ->  Aggregate
               Aggregates: COUNT(*)
               ->  Table Scan on public.query_offload_explain_left
                     Access Method: iceberg
                     Scan ID: 0
                     Output: id
                     Estimated Rows Read: 1
                     Estimated Bytes Read: 2731 bytes
                     Provider Startup Cost: 0.00
                     Filter: (id = 1)
                     Pushed Filter Conservative: (id = 1)
(17 rows)

-- VERBOSE may expose stable runtime-binding slots, but never the IR's
-- `$valueN` spelling or `#N` output identities.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, count(*)
FROM query_offload_explain_left
GROUP BY id
ORDER BY id
LIMIT 1 OFFSET 1;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Output: id, (count(*))
   Engine: DataFusion
   Maximum Batch Rows: 2
   ->  Limit
         Offset: Runtime Binding 1
         Count: Runtime Binding 2
         ->  Sort
               Sort Key: id ASC NULLS LAST
               ->  Projection
                     Output: id, COUNT(*)
                     ->  Aggregate
                           Group Key: id
                           Aggregates: COUNT(*)
                           ->  Table Scan on public.query_offload_explain_left
                                 Access Method: iceberg
                                 Scan ID: 0
                                 Output: id
(18 rows)

-- Join children and their relation aliases occupy one PostgreSQL Plans tree.
EXPLAIN (COSTS OFF)
SELECT l.key, count(*)
FROM query_offload_explain_left AS l
JOIN query_offload_explain_right AS r USING (key)
GROUP BY l.key
ORDER BY l.key;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: l.key ASC NULLS LAST
         ->  Aggregate
               Group Key: l.key
               Aggregates: COUNT(*)
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: l.key = r.key
                     ->  Table Scan on query_offload_explain_left l
                           Access Method: iceberg
                     ->  Table Scan on query_offload_explain_right r
                           Access Method: iceberg
(14 rows)

-- Text headings and expressions use PostgreSQL identifier quoting rather than
-- concatenating raw relation aliases.
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM query_offload_explain_left AS "Left Side"
JOIN query_offload_explain_right AS "Right Side"
  ON "Left Side".key = "Right Side".key;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*)
         ->  Hash Join
               Join Type: Inner
               Hash Cond: "Left Side".key = "Right Side".key
               ->  Table Scan on query_offload_explain_left "Left Side"
                     Access Method: iceberg
               ->  Table Scan on query_offload_explain_right "Right Side"
                     Access Method: iceberg
(11 rows)

-- Actual metrics survive COSTS OFF, are associated with their scan leaves,
-- and exclude timing when PostgreSQL requests TIMING OFF.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT l.key, count(*)
FROM query_offload_explain_left AS l
JOIN query_offload_explain_right AS r USING (key)
GROUP BY l.key
ORDER BY l.key;
                             QUERY PLAN                              
---------------------------------------------------------------------
