SET client_min_messages = warning;
DROP SCHEMA spark_interop_v2 CASCADE;
DROP SERVER spark_v2_rest CASCADE;
DROP TABLESPACE :"object_tablespace";
RESET client_min_messages;
\! rm -rf "$LAGODB_REGRESS_TABLESPACE_PATH"/*
