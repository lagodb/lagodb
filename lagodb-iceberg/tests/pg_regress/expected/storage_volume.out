cancel_delivered_after_cleanup: true
foreground_open_reached: true
foreground_socket_wait_reached: true
foreground_cancel_sent: true
foreground_cancel_delivered: true
SELECT CASE WHEN count(*) = 1 THEN 'true' ELSE 'false' END
       AS storage_usable_after_cancel
FROM storage_socket_cancel_contexts_t;
