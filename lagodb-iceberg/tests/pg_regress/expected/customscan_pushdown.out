       md5(COALESCE(string_agg(id::text || '|' || payload, E'\n' ORDER BY id, payload), '')) AS row_digest
FROM customscan_exact_pushdown_int4
WHERE id = 25;
 row_count |            row_digest            
-----------+----------------------------------
