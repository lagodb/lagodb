-- int4eq (=), opno 96
SET lagodb.customscan_mode = 'force';
EXPLAIN (COSTS OFF)
SELECT COUNT(*) AS row_count,
       md5(COALESCE(string_agg(id::text || '|' || payload, E'\n' ORDER BY id, payload), '')) AS row_digest
FROM customscan_exact_pushdown_int4
WHERE id = 25;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Aggregate
   ->  Sort
         Sort Key: payload
         ->  Custom Scan (lagodb-iceberg) on customscan_exact_pushdown_int4
               Pushed Filter: (id = 25)
(5 rows)

