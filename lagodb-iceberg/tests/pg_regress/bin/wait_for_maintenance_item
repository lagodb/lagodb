#!/usr/bin/env sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: wait_for_maintenance_item TIMEOUT_SECONDS" >&2
    exit 2
fi

volume_id=${LAGODB_REGRESS_VOLUME_ID:?LAGODB_REGRESS_VOLUME_ID is required}
namespace=${LAGODB_REGRESS_OBJECT_NAMESPACE:?LAGODB_REGRESS_OBJECT_NAMESPACE is required}
object_path=${LAGODB_REGRESS_OBJECT_PATH:?LAGODB_REGRESS_OBJECT_PATH is required}
timeout_seconds=$1
deadline=$(( $(date +%s) + timeout_seconds ))
last_error=""

while :; do
    if complete=$(psql -XAtq -v ON_ERROR_STOP=1 \
        --set=volume_id="$volume_id" \
        --set=namespace="$namespace" \
        --set=object_path="$object_path" 2>&1 <<'SQL'
SELECT NOT EXISTS (
    SELECT 1
    FROM lagodb.maintenance_queue
    WHERE volume_id = :'volume_id'
      AND object_namespace = :'namespace'
      AND (
          (operation = 1
           AND left(object_path, length(:'object_path')) = :'object_path')
          OR (operation = 2 AND object_path = :'object_path')
      )
);
SQL
    ); then
        if [ "$complete" = "t" ]; then
            echo "maintenance_complete: true"
            exit 0
        fi
        last_error="unexpected maintenance result: $complete"
    else
        last_error=$complete
    fi

    if [ "$(date +%s)" -ge "$deadline" ]; then
        psql -X -v ON_ERROR_STOP=1 \
            --set=volume_id="$volume_id" \
            --set=namespace="$namespace" \
            --set=object_path="$object_path" >&2 <<'SQL' || true
SELECT item_id,
       operation,
       object_path,
       producer,
       source_relid,
       state,
       attempt_count,
       revision,
       not_before,
       last_error
FROM lagodb.maintenance_status
WHERE volume_id = :'volume_id'
  AND object_namespace = :'namespace'
  AND (
      (operation = 'delete_object'
       AND left(object_path, length(:'object_path')) = :'object_path')
      OR (operation = 'delete_tree' AND object_path = :'object_path')
  )
ORDER BY created_at, item_id;

SELECT extension_name,
       worker_name,
       registration_state,
       process_state,
       pid,
       needs_restart,
       restart_after_ms,
       stop_requested
FROM lagodb.worker_status
WHERE database_oid = (
    SELECT oid
    FROM pg_catalog.pg_database
    WHERE datname = pg_catalog.current_database()
)
  AND extension_name = 'lagodb_base'
  AND worker_name = 'maintenance';

SELECT process_kind,
       database_oid,
       state,
       pid
FROM lagodb.process_status
WHERE process_kind IN ('supervisor', 'coordinator')
  AND (database_oid IS NULL
       OR database_oid = (
           SELECT oid
           FROM pg_catalog.pg_database
           WHERE datname = pg_catalog.current_database()
       ))
ORDER BY process_kind;
SQL
        echo "maintenance_complete: false" >&2
        if [ -n "$last_error" ]; then
            echo "$last_error" >&2
        fi
        exit 1
    fi
    sleep 0.05
done
