#!/usr/bin/env sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: wait_for_object_store TIMEOUT_SECONDS" >&2
    exit 2
fi

volume_id=${LAGODB_REGRESS_VOLUME_ID:?LAGODB_REGRESS_VOLUME_ID is required}
namespace=${LAGODB_REGRESS_OBJECT_NAMESPACE:?LAGODB_REGRESS_OBJECT_NAMESPACE is required}
timeout_seconds=$1
deadline=$(( $(date +%s) + timeout_seconds ))
last_error=""

while :; do
    if output=$(psql -XAtq -v ON_ERROR_STOP=1 \
        --set=volume_id="$volume_id" \
        --set=namespace="$namespace" 2>&1 <<'SQL'
SELECT objects = 0
FROM lagodb.observe_object_tree(
    :'volume_id', :'namespace', '__lagodb_regress_probe__'
);
SQL
    ); then
        if [ "$output" = "t" ]; then
            echo "object_store_ready: true"
            exit 0
        fi
        last_error="unexpected readiness result: $output"
    else
        last_error=$output
    fi

    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "object_store_ready: false" >&2
        if [ -n "$last_error" ]; then
            echo "$last_error" >&2
        fi
        exit 1
    fi

    sleep 0.05
done
