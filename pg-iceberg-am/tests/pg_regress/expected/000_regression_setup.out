-- Provision the object-storage fixture used by object-backed pg_regress tests.
-- pg_regress unsets PGDATABASE and passes the database only via psql -d, so
-- export it for the fixture's own psql calls. `\!` does not interpolate psql
-- variables (OT_WHOLE_LINE), but `\setenv` arguments (OT_NORMAL) do.
\setenv PGDATABASE :DBNAME
\! bin/object_storage_fixture setup
object_storage_setup: true
-- Install the shared Lakebase runtime once for the regression database.
-- Individual AM tests may drop/recreate pg_iceberg_am, but the base-owned
-- maintenance queue and database-local worker registration must survive.
CREATE EXTENSION pg_lakebase_runtime;
SELECT extname
FROM pg_extension
WHERE extname = 'pg_lakebase_runtime';
       extname       
---------------------
 pg_lakebase_runtime
(1 row)

-- Runtime setup complete.
