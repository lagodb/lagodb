-- Exercise transaction and database lifecycle behavior in isolated databases.
\setenv PGDATABASE :DBNAME
\! bin/worker_runtime_lifecycle
worker_create_rollback: true
worker_savepoint_rollback: true
worker_drop_rollback: true
worker_drop_pending_guard: true
worker_non_superuser_guard: true
worker_non_superuser_wakeup: true
worker_scheduled_wakeup: true
worker_template_database: true
worker_drop_database: true
