#!/usr/bin/env sh
set -eu

database=${PGDATABASE:?PGDATABASE is required}
source_db=lakebase_runtime_source
copy_db=lakebase_runtime_copy
test_role=lakebase_runtime_non_superuser

cleanup() {
    psql -XAtq -v ON_ERROR_STOP=0 -d "$source_db" \
        -c "SELECT injection_points_detach('lakebase-runtime-worker-after-database-connection')" \
        >/dev/null 2>&1 || true
    psql -XAtq -v ON_ERROR_STOP=0 -d "$database" <<SQL >/dev/null 2>&1 || true
DROP DATABASE IF EXISTS $copy_db WITH (FORCE);
DROP DATABASE IF EXISTS $source_db WITH (FORCE);
DROP ROLE IF EXISTS $test_role;
SQL
}
trap cleanup EXIT HUP INT TERM
cleanup

psql -XAtq -v ON_ERROR_STOP=1 -d "$database" <<SQL >/dev/null
CREATE DATABASE $source_db;
CREATE ROLE $test_role;
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$source_db" <<SQL >/dev/null
DO \$\$
DECLARE
    denied boolean := false;
BEGIN
    SET LOCAL ROLE $test_role;
    BEGIN
        EXECUTE 'CREATE EXTENSION pg_lakebase_runtime';
    EXCEPTION WHEN insufficient_privilege THEN
        denied := true;
    END;
    IF NOT denied OR EXISTS (
        SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime'
    ) THEN
        RAISE EXCEPTION 'non-superuser runtime installation was allowed';
    END IF;
END
\$\$;
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$source_db" <<'SQL' >/dev/null
BEGIN;
CREATE EXTENSION pg_lakebase_runtime;
ROLLBACK;
DO $$
BEGIN
    IF EXISTS (SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime') THEN
        RAISE EXCEPTION 'CREATE EXTENSION rollback leaked the extension';
    END IF;
END
$$;

BEGIN;
SAVEPOINT before_runtime;
CREATE EXTENSION pg_lakebase_runtime;
ROLLBACK TO SAVEPOINT before_runtime;
COMMIT;
DO $$
BEGIN
    IF EXISTS (SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime') THEN
        RAISE EXCEPTION 'savepoint rollback leaked the extension';
    END IF;
END
$$;

CREATE EXTENSION pg_lakebase_runtime;
DO $$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status
            WHERE database_oid = (SELECT oid FROM pg_database WHERE datname = current_database())
              AND extension_name = 'pg_lakebase_runtime'
              AND worker_name = 'maintenance'
              AND registration_state = 'registered'
              AND dispatch_state = 'idle'
              AND process_state = 'stopped'
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status) ORDER BY database_oid,
                                                        extension_name,
                                                        worker_name)::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE database_oid = (SELECT oid FROM pg_database
                              WHERE datname = current_database());
        RAISE EXCEPTION 'committed registration did not become idle and stopped'
            USING DETAIL = status_details;
    END IF;
END
$$;

-- Exercise the production PostgreSQL injection-point path: an ERROR after the
-- worker's database connection must be recorded as a crash, enter backoff,
-- and recover after the cluster-wide attachment is detached.
CREATE EXTENSION injection_points;
CREATE TEMP TABLE native_injection_generation AS
SELECT generation
FROM lakebase.worker_runtime_status
WHERE database_oid = (SELECT oid FROM pg_database
                      WHERE datname = current_database())
  AND extension_name = 'pg_lakebase_runtime'
  AND worker_name = 'maintenance';
SELECT injection_points_attach(
    'lakebase-runtime-worker-after-database-connection',
    'error'
);
SELECT lakebase.request_worker_wakeup('pg_lakebase_runtime', 'maintenance');
DO $$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status AS status
            CROSS JOIN native_injection_generation AS previous
            WHERE status.database_oid = (SELECT oid FROM pg_database
                                          WHERE datname = current_database())
              AND status.extension_name = 'pg_lakebase_runtime'
              AND status.worker_name = 'maintenance'
              AND status.generation > previous.generation
              AND status.dispatch_state = 'delayed'
              AND status.process_state = 'stopped'
              AND status.not_before_ms IS NOT NULL
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status))::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE status.database_oid = (SELECT oid FROM pg_database
                                      WHERE datname = current_database());
        RAISE EXCEPTION 'native worker injection did not enter crash backoff'
            USING DETAIL = status_details;
    END IF;
END
$$;
SELECT injection_points_detach(
    'lakebase-runtime-worker-after-database-connection'
);
UPDATE native_injection_generation
SET generation = status.generation
FROM lakebase.worker_runtime_status AS status
WHERE status.database_oid = (SELECT oid FROM pg_database
                             WHERE datname = current_database())
  AND status.extension_name = 'pg_lakebase_runtime'
  AND status.worker_name = 'maintenance';
SELECT lakebase.request_worker_wakeup('pg_lakebase_runtime', 'maintenance');
DO $$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status AS status
            CROSS JOIN native_injection_generation AS previous
            WHERE status.database_oid = (SELECT oid FROM pg_database
                                          WHERE datname = current_database())
              AND status.extension_name = 'pg_lakebase_runtime'
              AND status.worker_name = 'maintenance'
              AND status.generation > previous.generation
              AND status.dispatch_state = 'idle'
              AND status.process_state = 'stopped'
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status))::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE status.database_oid = (SELECT oid FROM pg_database
                                      WHERE datname = current_database());
        RAISE EXCEPTION 'worker did not recover after native injection detach'
            USING DETAIL = status_details;
    END IF;
END
$$;
DROP EXTENSION injection_points;

BEGIN;
DROP EXTENSION pg_lakebase_runtime;
ROLLBACK;
DO $$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status
            WHERE database_oid = (SELECT oid FROM pg_database WHERE datname = current_database())
              AND extension_name = 'pg_lakebase_runtime'
              AND worker_name = 'maintenance'
              AND registration_state = 'registered'
              AND dispatch_state = 'idle'
              AND process_state = 'stopped'
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT EXISTS (SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime') THEN
        RAISE EXCEPTION 'DROP EXTENSION rollback lost the extension';
    END IF;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status) ORDER BY database_oid,
                                                        extension_name,
                                                        worker_name)::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE database_oid = (SELECT oid FROM pg_database
                              WHERE datname = current_database());
        RAISE EXCEPTION 'DROP EXTENSION rollback did not reactivate its worker'
            USING DETAIL = status_details;
    END IF;
END
$$;

INSERT INTO lakebase.maintenance_queue (
    item_id, operation, store_id, object_namespace, object_path, producer,
    attempt_count, not_before, failed, created_at
) VALUES (
    '00000000-0000-0000-0000-000000000001', 1, 'test', 'test', 'test',
    'runtime-lifecycle-test', 0, clock_timestamp(), true, clock_timestamp()
);
DO $$
DECLARE
    rejected boolean := false;
    error_message text;
    error_detail text;
    error_hint text;
BEGIN
    IF NOT EXISTS (SELECT FROM lakebase.maintenance_queue) THEN
        RAISE EXCEPTION 'maintenance guard fixture disappeared';
    END IF;
    BEGIN
        EXECUTE 'DROP EXTENSION pg_lakebase_runtime';
    EXCEPTION WHEN OTHERS THEN
        rejected := true;
        GET STACKED DIAGNOSTICS
            error_message = MESSAGE_TEXT,
            error_detail = PG_EXCEPTION_DETAIL,
            error_hint = PG_EXCEPTION_HINT;
    END;
    IF NOT rejected OR NOT EXISTS (
        SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime'
    ) THEN
        RAISE EXCEPTION 'non-empty maintenance queue did not protect pg_lakebase_runtime';
    END IF;
    IF error_message <> 'cannot drop pg_lakebase_runtime while the maintenance queue contains unresolved work'
       OR error_detail IS NULL
       OR position('failed queue rows are unresolved' in error_detail) = 0
       OR error_hint IS NULL
       OR position('lakebase.retry_maintenance_item(item_id)' in error_hint) = 0 THEN
        RAISE EXCEPTION 'maintenance queue guard did not explain operator recovery';
    END IF;
END
$$;
DELETE FROM lakebase.maintenance_queue
WHERE item_id = '00000000-0000-0000-0000-000000000001';

CREATE EXTENSION pg_iceberg_am;
DO $$
DECLARE
    rejected boolean := false;
    error_detail text;
    error_hint text;
BEGIN
    BEGIN
        EXECUTE 'DROP EXTENSION pg_lakebase_runtime, pg_iceberg_am';
    EXCEPTION WHEN dependent_objects_still_exist THEN
        rejected := true;
        GET STACKED DIAGNOSTICS
            error_detail = PG_EXCEPTION_DETAIL,
            error_hint = PG_EXCEPTION_HINT;
    END;
    IF NOT rejected
       OR NOT EXISTS (SELECT FROM pg_extension WHERE extname = 'pg_lakebase_runtime')
       OR NOT EXISTS (SELECT FROM pg_extension WHERE extname = 'pg_iceberg_am') THEN
        RAISE EXCEPTION 'combined extension drop bypassed the runtime dependency guard';
    END IF;
    IF error_detail IS NULL
       OR position('same DROP EXTENSION statement' in error_detail) = 0
       OR error_hint IS NULL
       OR position('separate DROP EXTENSION statement and commit it first' in error_hint) = 0 THEN
        RAISE EXCEPTION 'runtime dependency guard did not explain the required drop order';
    END IF;
END
$$;
DROP EXTENSION pg_iceberg_am;
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$source_db" <<SQL >/dev/null
DO \$\$
DECLARE
    denied boolean := false;
BEGIN
    SET LOCAL ROLE $test_role;
    BEGIN
        PERFORM lakebase.deregister_worker('maintenance');
    EXCEPTION WHEN insufficient_privilege THEN
        denied := true;
    END;
    IF NOT denied THEN
        RAISE EXCEPTION 'non-superuser worker deregistration was allowed';
    END IF;
END
\$\$;

INSERT INTO lakebase.maintenance_queue (
    item_id, operation, store_id, object_namespace, object_path, producer,
    attempt_count, not_before, failed, created_at
) VALUES (
    '00000000-0000-0000-0000-000000000002', 1, 'test', 'test', 'future',
    'runtime-lifecycle-test', 0, clock_timestamp() + interval '1 hour', false,
    clock_timestamp()
);
SELECT lakebase.request_worker_wakeup('pg_lakebase_runtime', 'maintenance');
DO \$\$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status
            WHERE database_oid = (SELECT oid FROM pg_database
                                    WHERE datname = current_database())
              AND extension_name = 'pg_lakebase_runtime'
              AND worker_name = 'maintenance'
              AND dispatch_state = 'delayed'
              AND process_state = 'stopped'
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status) ORDER BY database_oid,
                                                        extension_name,
                                                        worker_name)::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE database_oid = (SELECT oid FROM pg_database
                              WHERE datname = current_database());
        RAISE EXCEPTION 'maintenance worker did not publish its future schedule'
            USING DETAIL = status_details;
    END IF;
END
\$\$;

INSERT INTO lakebase.maintenance_queue (
    item_id, operation, store_id, object_namespace, object_path, producer,
    attempt_count, not_before, failed, created_at
) VALUES (
    '00000000-0000-0000-0000-000000000003', 999, 'test', 'test', 'ready',
    'runtime-lifecycle-test', 0, clock_timestamp(), false, clock_timestamp()
);
SET ROLE $test_role;
SELECT lakebase.request_worker_wakeup('pg_lakebase_runtime', 'maintenance');
RESET ROLE;
DO \$\$
DECLARE
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        EXIT WHEN EXISTS (
            SELECT FROM lakebase.maintenance_queue
            WHERE item_id = '00000000-0000-0000-0000-000000000003'
              AND failed
        );
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT EXISTS (
        SELECT FROM lakebase.maintenance_queue
        WHERE item_id = '00000000-0000-0000-0000-000000000003'
          AND failed
    ) THEN
        SELECT jsonb_build_object(
            'workers', coalesce((
                SELECT jsonb_agg(to_jsonb(status) ORDER BY database_oid,
                                                          extension_name,
                                                          worker_name)
                FROM lakebase.worker_runtime_status AS status
                WHERE database_oid = (SELECT oid FROM pg_database
                                      WHERE datname = current_database())
            ), '[]'::jsonb),
            'queue', coalesce((
                SELECT jsonb_agg(to_jsonb(item))
                FROM lakebase.maintenance_status AS item
            ), '[]'::jsonb)
        )::text
        INTO status_details;
        RAISE EXCEPTION 'committed wakeup did not advance scheduled worker'
            USING DETAIL = status_details;
    END IF;
END
\$\$;
DELETE FROM lakebase.maintenance_queue
WHERE item_id IN (
    '00000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000003'
);
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$database" <<SQL >/dev/null
CREATE DATABASE $copy_db TEMPLATE $source_db;
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$copy_db" <<'SQL' >/dev/null
DO $$
DECLARE
    observed boolean := false;
    status_details text;
BEGIN
    FOR attempt IN 1..200 LOOP
        SELECT EXISTS (
            SELECT FROM lakebase.worker_runtime_status
            WHERE database_oid = (SELECT oid FROM pg_database WHERE datname = current_database())
              AND extension_name = 'pg_lakebase_runtime'
              AND worker_name = 'maintenance'
              AND registration_state = 'registered'
              AND dispatch_state = 'idle'
              AND process_state = 'stopped'
        ) INTO observed;
        EXIT WHEN observed;
        PERFORM pg_sleep(0.05);
    END LOOP;
    IF NOT observed THEN
        SELECT coalesce(jsonb_agg(to_jsonb(status) ORDER BY database_oid,
                                                        extension_name,
                                                        worker_name)::text, '[]')
        INTO status_details
        FROM lakebase.worker_runtime_status AS status
        WHERE database_oid = (SELECT oid FROM pg_database
                              WHERE datname = current_database());
        RAISE EXCEPTION 'template database registration was not discovered'
            USING DETAIL = status_details;
    END IF;
END
$$;
SQL

psql -XAtq -v ON_ERROR_STOP=1 -d "$database" <<SQL >/dev/null
DROP DATABASE $copy_db;
DROP DATABASE $source_db;
DROP ROLE $test_role;
SQL

trap - EXIT HUP INT TERM
echo "worker_create_rollback: true"
echo "worker_savepoint_rollback: true"
echo "worker_drop_rollback: true"
echo "worker_drop_pending_guard: true"
echo "worker_non_superuser_guard: true"
echo "worker_non_superuser_wakeup: true"
echo "worker_scheduled_wakeup: true"
echo "worker_template_database: true"
echo "worker_drop_database: true"
