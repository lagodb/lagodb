\i include/column_definitions.sql
-- Foreign tables do not support LIKE; share column lists through psql variables.
\set common_columns 'id integer, bool_col boolean, smallint_col smallint, integer_col integer, bigint_col bigint, real_col real, double_col double precision, numeric_col numeric(12, 3), text_col text, varchar_col varchar(20), char_col character(5), name_col name, bytea_col bytea, uuid_col uuid, date_col date, time_col time without time zone, timestamp_col timestamp without time zone, timestamptz_col timestamp with time zone'
\set avro_columns 'id integer, bool_col boolean, smallint_col integer, integer_col integer, bigint_col bigint, real_col real, double_col double precision, numeric_col numeric(12, 3), text_col text, varchar_col varchar(20), char_col character(5), name_col name, bytea_col bytea, uuid_col uuid, date_col date, time_col time without time zone, timestamp_col timestamp without time zone, timestamptz_col timestamp with time zone'
\set json_columns :common_columns ', json_col json, jsonb_col jsonb'
\set parquet_columns :common_columns ', json_col json, bool_array boolean[], smallint_array smallint[], integer_array integer[], bigint_array bigint[], real_array real[], double_array double precision[], text_array text[], varchar_array varchar(20)[], bpchar_array character(5)[], name_array name[], json_array json[], bytea_array bytea[], uuid_array uuid[], numeric_array numeric(12, 3)[], date_array date[], time_array time[], timestamp_array timestamp[], timestamptz_array timestamptz[]'
\set stream_extra_columns 'id integer, json_col json, jsonb_col jsonb, bool_array boolean[], int_array integer[], text_array text[]'
\set id_payload_columns 'id integer, payload text'
-- Avro format COPY, foreign-table, inference, and scan-state coverage.
SELECT bucket AS lagodb_regress_bucket
FROM lagodb_regress.object_storage_fixture
\gset
\set avro_base 's3://' :lagodb_regress_bucket '/lagodb-connectors/avro/'
\pset null _null_
-- COPY round trip through an exact object; the suffix selects the format.
\set avro_exact_path :avro_base 'exact.avro'
COPY lagodb_connectors_regress.avro_source TO :'avro_exact_path'
WITH (server 'lagodb_connectors_regress_s3');
CREATE TABLE lagodb_connectors_regress.avro_copy (:avro_columns);
COPY lagodb_connectors_regress.avro_copy FROM :'avro_exact_path'
WITH (server 'lagodb_connectors_regress_s3');
SELECT * FROM lagodb_connectors_regress.avro_copy ORDER BY id;
 id | bool_col | smallint_col | integer_col | bigint_col  | real_col | double_col | numeric_col |       text_col       | varchar_col | char_col | name_col | bytea_col  |               uuid_col               |  date_col  |    time_col     |          timestamp_col          |           timestamptz_col           
----+----------+--------------+-------------+-------------+----------+------------+-------------+----------------------+-------------+----------+----------+------------+--------------------------------------+------------+-----------------+---------------------------------+-------------------------------------
  1 | t        |            7 |          11 |  9000000000 |     1.25 |        2.5 |   12345.678 | comma,value "quoted"+| varchar-one | abc      | name-one | \x000102ff | 00000000-0000-0000-0000-000000000001 | 01-02-2024 | 03:04:05.123456 | Tue Jan 02 03:04:05.123456 2024 | Mon Jan 01 19:04:05.123456 2024 PST
    |          |              |             |             |          |            |             | line                 |             |          |          |            |                                      |            |                 |                                 | 
  2 | f        |       _null_ |         -12 | -9000000000 |   _null_ |       -2.5 |    -123.450 | _null_               |             | xy       | _null_   | _null_     | 00000000-0000-0000-0000-000000000002 | _null_     | 23:59:59        | _null_                          | Fri Jun 07 01:09:10 2024 PDT
(2 rows)

-- A Snappy-compressed container.
\set avro_snappy_path :avro_base 'snappy.avro'
COPY lagodb_connectors_regress.avro_source TO :'avro_snappy_path'
WITH (server 'lagodb_connectors_regress_s3', format 'avro', compression 'snappy');
TRUNCATE lagodb_connectors_regress.avro_copy;
COPY lagodb_connectors_regress.avro_copy FROM :'avro_snappy_path'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
SELECT * FROM lagodb_connectors_regress.avro_copy ORDER BY id;
 id | bool_col | smallint_col | integer_col | bigint_col  | real_col | double_col | numeric_col |       text_col       | varchar_col | char_col | name_col | bytea_col  |               uuid_col               |  date_col  |    time_col     |          timestamp_col          |           timestamptz_col           
----+----------+--------------+-------------+-------------+----------+------------+-------------+----------------------+-------------+----------+----------+------------+--------------------------------------+------------+-----------------+---------------------------------+-------------------------------------
  1 | t        |            7 |          11 |  9000000000 |     1.25 |        2.5 |   12345.678 | comma,value "quoted"+| varchar-one | abc      | name-one | \x000102ff | 00000000-0000-0000-0000-000000000001 | 01-02-2024 | 03:04:05.123456 | Tue Jan 02 03:04:05.123456 2024 | Mon Jan 01 19:04:05.123456 2024 PST
    |          |              |             |             |          |            |             | line                 |             |          |          |            |                                      |            |                 |                                 | 
  2 | f        |       _null_ |         -12 | -9000000000 |   _null_ |       -2.5 |    -123.450 | _null_               |             | xy       | _null_   | _null_     | 00000000-0000-0000-0000-000000000002 | _null_     | 23:59:59        | _null_                          | Fri Jun 07 01:09:10 2024 PDT
(2 rows)

-- An empty container is valid input.
\set avro_empty_path :avro_base 'empty.avro'
COPY (SELECT * FROM lagodb_connectors_regress.avro_source WHERE false)
TO :'avro_empty_path'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
TRUNCATE lagodb_connectors_regress.avro_copy;
COPY lagodb_connectors_regress.avro_copy FROM :'avro_empty_path'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
SELECT count(*) AS empty_rows FROM lagodb_connectors_regress.avro_copy;
 empty_rows 
------------
          0
(1 row)

-- Exact foreign scan and Avro-owned schema inference.
