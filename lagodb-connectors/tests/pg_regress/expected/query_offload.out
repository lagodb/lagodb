\i include/column_definitions.sql
-- Foreign tables do not support LIKE; share column lists through psql variables.
\set common_columns 'id integer, bool_col boolean, smallint_col smallint, integer_col integer, bigint_col bigint, real_col real, double_col double precision, numeric_col numeric(12, 3), text_col text, varchar_col varchar(20), char_col character(5), name_col name, bytea_col bytea, uuid_col uuid, date_col date, time_col time without time zone, timestamp_col timestamp without time zone, timestamptz_col timestamp with time zone'
\set avro_columns 'id integer, bool_col boolean, smallint_col integer, integer_col integer, bigint_col bigint, real_col real, double_col double precision, numeric_col numeric(12, 3), text_col text, varchar_col varchar(20), char_col character(5), name_col name, bytea_col bytea, uuid_col uuid, date_col date, time_col time without time zone, timestamp_col timestamp without time zone, timestamptz_col timestamp with time zone'
\set json_columns :common_columns ', json_col json, jsonb_col jsonb'
\set parquet_columns :common_columns ', json_col json, bool_array boolean[], smallint_array smallint[], integer_array integer[], bigint_array bigint[], real_array real[], double_array double precision[], text_array text[], varchar_array varchar(20)[], bpchar_array character(5)[], name_array name[], json_array json[], bytea_array bytea[], uuid_array uuid[], numeric_array numeric(12, 3)[], date_array date[], time_array time[], timestamp_array timestamp[], timestamptz_array timestamptz[]'
\set stream_extra_columns 'id integer, json_col json, jsonb_col jsonb, bool_array boolean[], int_array integer[], text_array text[]'
\set id_payload_columns 'id integer, payload text'
-- Parquet query offload: declared-type projection, footer COUNT, predicate
-- pushdown, generic-plan parameters, parallel workers and FDW fallback.
SELECT bucket FROM lagodb_regress.object_storage_fixture \gset storage_
\set offload_base 's3://' :storage_bucket '/lagodb-connectors/query-offload/'
\pset null _null_
-- Two objects under one prefix; the declared table covers every scalar and
-- array type the Parquet contract admits.
\set offload_prefix :offload_base 'types/'
\set offload_part :offload_prefix 'part-a.parquet'
COPY (SELECT * FROM lagodb_connectors_regress.parquet_source WHERE id = 1)
TO :'offload_part'
WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
\set offload_part :offload_prefix 'part-b.parquet'
COPY (SELECT * FROM lagodb_connectors_regress.parquet_source WHERE id <> 1)
TO :'offload_part'
WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
CREATE FOREIGN TABLE lagodb_connectors_regress.offload_types (:parquet_columns)
SERVER lagodb_connectors_regress_s3
OPTIONS (path :'offload_prefix', format 'parquet');
-- Thirty-three objects of 100 rows. Each object weighs the 4 MiB open cost
-- and a split group targets 128 MiB, so parallel execution has two groups.
\set offload_wide :offload_base 'wide/'
\set ECHO none
CREATE FOREIGN TABLE lagodb_connectors_regress.offload_wide (
    id integer, group_key integer, measure integer, payload text COLLATE "C"
)
SERVER lagodb_connectors_regress_s3
OPTIONS (path :'offload_wide', format 'parquet');
SET lagodb.query_offload_mode = 'force';
SET lagodb.query_batch_rows = 2;
-- Offload starts at a join or an aggregate. Through a self-join every
-- declared column crosses the engine as its canonical type and back.
EXPLAIN (COSTS OFF)
SELECT t.*
FROM lagodb_connectors_regress.offload_types AS t
JOIN lagodb_connectors_regress.offload_types AS u USING (id)
ORDER BY id;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: t.id ASC NULLS LAST
         ->  Projection
               ->  Hash Join
                     Join Type: Inner
                     Hash Cond: t.id = u.id
                     ->  Table Scan on offload_types t
                           Foreign Data Wrapper: lagodb_connectors
                     ->  Table Scan on offload_types u
                           Foreign Data Wrapper: lagodb_connectors
(12 rows)

SELECT t.*
FROM lagodb_connectors_regress.offload_types AS t
JOIN lagodb_connectors_regress.offload_types AS u USING (id)
ORDER BY id;
