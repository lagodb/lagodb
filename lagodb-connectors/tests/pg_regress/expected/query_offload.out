-- A generic parameter is bound per execution of one planned source.
SET plan_cache_mode = force_generic_plan;
PREPARE offload_by_id(integer) AS
SELECT count(*) AS rows, sum(measure) AS total
FROM lagodb_connectors_regress.offload_wide
WHERE id >= $1;
EXPLAIN (COSTS OFF) EXECUTE offload_by_id(3290);
                      QUERY PLAN                       
-------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Aggregate
         Aggregates: COUNT(*), SUM(measure)
         ->  Table Scan on offload_wide
               Foreign Data Wrapper: lagodb_connectors
               Filter: (id >= $1)
               Pushed Filter: (id >= $1)
(8 rows)

EXECUTE offload_by_id(3290);
 rows | total  
------+--------
   11 | 362450
(1 row)

EXECUTE offload_by_id(1);
 rows |  total   
------+----------
 3300 | 54466500
(1 row)

DEALLOCATE offload_by_id;
RESET plan_cache_mode;
-- Grouping and ordering run in one offloaded fragment.
EXPLAIN (COSTS OFF)
SELECT group_key, count(*) AS rows, sum(measure) AS total
FROM lagodb_connectors_regress.offload_wide
WHERE id > 100
GROUP BY group_key
ORDER BY group_key;
                         QUERY PLAN                          
-------------------------------------------------------------
 Custom Scan (LagoDB Query Offload)
   Engine: DataFusion
   ->  Sort
         Sort Key: group_key ASC NULLS LAST
         ->  Aggregate
               Group Key: group_key
               Aggregates: COUNT(*), SUM(measure)
               ->  Table Scan on offload_wide
                     Foreign Data Wrapper: lagodb_connectors
                     Filter: (id > 100)
                     Pushed Filter: (id > 100)
(11 rows)

SELECT group_key, count(*) AS rows, sum(measure) AS total
FROM lagodb_connectors_regress.offload_wide
WHERE id > 100
GROUP BY group_key
ORDER BY group_key;
