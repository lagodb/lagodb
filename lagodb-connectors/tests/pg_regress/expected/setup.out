\i include/column_definitions.sql
-- PostgreSQL rejects CREATE FOREIGN TABLE ... LIKE before an FDW callback can
-- run. Keep the repeated regression-table shapes in psql variables so tests
-- exercise valid core syntax without duplicating long column lists.
\set common_columns 'id integer, bool_col boolean, smallint_col smallint, integer_col integer, bigint_col bigint, real_col real, double_col double precision, numeric_col numeric(12, 3), text_col text, varchar_col varchar(20), char_col character(5), name_col name, bytea_col bytea, uuid_col uuid, date_col date, time_col time without time zone, timestamp_col timestamp without time zone, timestamptz_col timestamp with time zone'
\set json_columns :common_columns ', json_col json, jsonb_col jsonb'
\set parquet_columns :common_columns ', json_col json, bool_array boolean[], smallint_array smallint[], integer_array integer[], bigint_array bigint[], real_array real[], double_array double precision[], text_array text[], varchar_array varchar(20)[], bpchar_array character(5)[], name_array name[], json_array json[]'
\set stream_extra_columns 'id integer, json_col json, jsonb_col jsonb, bool_array boolean[], int_array integer[], text_array text[]'
\set id_payload_columns 'id integer, payload text'
-- LagoDB connector regression fixture.
--
-- The fixture is intentionally provisioned here rather than by every test:
-- pgrx runs setup.sql once for the reset database, and the object names below
-- make the individual tests safe to run in any order after setup.
\setenv PGDATABASE :DBNAME
\! ../../../scripts/pg_regress/object_storage_fixture setup
object_storage_setup: true
SET TIME ZONE 'UTC';
SET client_min_messages = warning;
CREATE EXTENSION pg_lakebase_runtime;
CREATE EXTENSION lagodb_connectors;
SELECT endpoint AS lakebase_regress_endpoint,
       bucket AS lakebase_regress_bucket,
       format('s3://%s/', bucket) AS lakebase_regress_scope,
       region AS lakebase_regress_region,
       access_key_id AS lakebase_regress_access_key_id,
       secret_access_key AS lakebase_regress_secret_access_key
FROM lakebase_regress.object_storage_fixture
\gset
CREATE SCHEMA lagodb_connectors_regress;
CREATE SERVER lagodb_connectors_regress_s3
    FOREIGN DATA WRAPPER lagodb_connectors
    OPTIONS (
        provider 's3_compatible',
        endpoint :'lakebase_regress_endpoint',
        region :'lakebase_regress_region',
        scope :'lakebase_regress_scope',
        allow_http 'true',
        virtual_hosted_style_request 'false'
    );
CREATE USER MAPPING FOR PUBLIC
    SERVER lagodb_connectors_regress_s3
    OPTIONS (
        access_key_id :'lakebase_regress_access_key_id',
        secret_access_key :'lakebase_regress_secret_access_key'
    );
CREATE TABLE lagodb_connectors_regress.common_source (
    id integer,
    bool_col boolean,
    smallint_col smallint,
    integer_col integer,
    bigint_col bigint,
    real_col real,
    double_col double precision,
    numeric_col numeric(12, 3),
    text_col text,
    varchar_col varchar(20),
    char_col character(5),
    name_col name,
    bytea_col bytea,
    uuid_col uuid,
    date_col date,
    time_col time without time zone,
    timestamp_col timestamp without time zone,
    timestamptz_col timestamp with time zone
);
INSERT INTO lagodb_connectors_regress.common_source
VALUES
    (
        1,
        true,
        7,
        11,
        9000000000,
        1.25::real,
        2.5::double precision,
        12345.678,
        E'comma,value "quoted"\nline',
        'varchar-one',
        'abc',
        'name-one',
        decode('000102ff', 'hex'),
        '00000000-0000-0000-0000-000000000001',
        '2024-01-02',
        '03:04:05.123456',
        '2024-01-02 03:04:05.123456',
        '2024-01-02 03:04:05.123456+00'
    ),
    (
        2,
        false,
        NULL,
        -12,
        -9000000000,
        NULL,
        -2.5::double precision,
        -123.450,
        NULL,
        '',
        'xy',
        NULL,
        NULL,
        '00000000-0000-0000-0000-000000000002',
        NULL,
        '23:59:59',
        NULL,
        '2024-06-07 08:09:10+00'
    );
CREATE TABLE lagodb_connectors_regress.stream_extra_source (
    id integer,
    json_col json,
    jsonb_col jsonb,
    bool_array boolean[],
    int_array integer[],
    text_array text[]
);
INSERT INTO lagodb_connectors_regress.stream_extra_source
VALUES
    (
        1,
        '{"nested":[1,true],"text":"value"}',
        '{"nested":[1,true],"text":"value"}',
        ARRAY[true, false],
        ARRAY[1, 2, 3],
        ARRAY['a', 'comma,value', 'quote"value']
    ),
    (
        2,
        NULL,
        NULL,
        ARRAY[]::boolean[],
        NULL,
        ARRAY['']
    );
CREATE TABLE lagodb_connectors_regress.json_source
    (:common_columns);
ALTER TABLE lagodb_connectors_regress.json_source
    ADD COLUMN json_col json,
    ADD COLUMN jsonb_col jsonb;
INSERT INTO lagodb_connectors_regress.json_source
SELECT source.*,
       CASE WHEN source.id = 1
            THEN '{"nested":[1,true],"text":"value"}'::json
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN '{"nested":[1,true],"text":"value"}'::jsonb
            ELSE NULL
       END
FROM lagodb_connectors_regress.common_source AS source
ORDER BY source.id;
CREATE TABLE lagodb_connectors_regress.parquet_source
    (:common_columns);
ALTER TABLE lagodb_connectors_regress.parquet_source
    ADD COLUMN json_col json,
    ADD COLUMN bool_array boolean[],
    ADD COLUMN smallint_array smallint[],
    ADD COLUMN integer_array integer[],
    ADD COLUMN bigint_array bigint[],
    ADD COLUMN real_array real[],
    ADD COLUMN double_array double precision[],
    ADD COLUMN text_array text[],
    ADD COLUMN varchar_array varchar(20)[],
    ADD COLUMN bpchar_array character(5)[],
    ADD COLUMN name_array name[],
    ADD COLUMN json_array json[];
INSERT INTO lagodb_connectors_regress.parquet_source
SELECT source.*,
       CASE WHEN source.id = 1
            THEN '{"nested":[1,true],"text":"value"}'::json
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[true, false]
            ELSE ARRAY[]::boolean[]
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[7::smallint, -2::smallint]
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[11, -12]
            ELSE ARRAY[]::integer[]
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[9000000000::bigint, -9000000000::bigint]
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[1.25::real, -2.5::real]
            ELSE ARRAY[]::real[]
       END,
       CASE WHEN source.id = 1
            THEN ARRAY[2.5::double precision, -2.5::double precision]
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY['a', 'comma,value']
            ELSE ARRAY[]::text[]
       END,
       CASE WHEN source.id = 1
            THEN ARRAY['varchar-one'::varchar(20), 'two'::varchar(20)]
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY['abc'::character(5), 'xy'::character(5)]
            ELSE ARRAY[]::character(5)[]
       END,
       CASE WHEN source.id = 1
            THEN ARRAY['name-one'::name, 'name-two'::name]
            ELSE NULL
       END,
       CASE WHEN source.id = 1
            THEN ARRAY['{"a":1}'::json, '{"b":2}'::json]
            ELSE ARRAY[]::json[]
       END
FROM lagodb_connectors_regress.common_source AS source
ORDER BY source.id;
-- Seed objects are shared by the foreign-table and schema-inference tests.
-- Their keys are different from the direct-COPY outputs used by the copy tests.
SELECT format('s3://%s/lagodb-connectors/seed/common-exact.txt',
              :'lakebase_regress_bucket') AS seed_text_exact,
       format('s3://%s/lagodb-connectors/seed/common-prefix/',
              :'lakebase_regress_bucket') AS seed_text_prefix,
       format('s3://%s/lagodb-connectors/seed/common-prefix/part-a.txt',
              :'lakebase_regress_bucket') AS seed_text_part_a,
       format('s3://%s/lagodb-connectors/seed/common-prefix/part-b.txt',
              :'lakebase_regress_bucket') AS seed_text_part_b,
       format('s3://%s/lagodb-connectors/seed/common-exact.csv',
              :'lakebase_regress_bucket') AS seed_csv_exact,
       format('s3://%s/lagodb-connectors/seed/common-prefix-csv/',
              :'lakebase_regress_bucket') AS seed_csv_prefix,
       format('s3://%s/lagodb-connectors/seed/common-prefix-csv/part-a.csv',
              :'lakebase_regress_bucket') AS seed_csv_part_a,
       format('s3://%s/lagodb-connectors/seed/common-prefix-csv/part-b.csv',
              :'lakebase_regress_bucket') AS seed_csv_part_b,
       format('s3://%s/lagodb-connectors/seed/common-header.csv',
              :'lakebase_regress_bucket') AS seed_csv_header,
       format('s3://%s/lagodb-connectors/seed/common-exact.avro',
              :'lakebase_regress_bucket') AS seed_avro_exact,
       format('s3://%s/lagodb-connectors/seed/common-prefix-avro/',
              :'lakebase_regress_bucket') AS seed_avro_prefix,
       format('s3://%s/lagodb-connectors/seed/common-prefix-avro/part-a.avro',
              :'lakebase_regress_bucket') AS seed_avro_part_a,
       format('s3://%s/lagodb-connectors/seed/common-prefix-avro/part-b.avro',
              :'lakebase_regress_bucket') AS seed_avro_part_b,
       format('s3://%s/lagodb-connectors/seed/json-exact.json',
              :'lakebase_regress_bucket') AS seed_json_exact,
       format('s3://%s/lagodb-connectors/seed/json-prefix/',
              :'lakebase_regress_bucket') AS seed_json_prefix,
       format('s3://%s/lagodb-connectors/seed/json-prefix/part-a.json',
              :'lakebase_regress_bucket') AS seed_json_part_a,
       format('s3://%s/lagodb-connectors/seed/json-prefix/part-b.json',
              :'lakebase_regress_bucket') AS seed_json_part_b,
       format('s3://%s/lagodb-connectors/seed/json-compressed.json.gz',
              :'lakebase_regress_bucket') AS seed_json_compressed,
       format('s3://%s/lagodb-connectors/seed/parquet-exact.parquet',
              :'lakebase_regress_bucket') AS seed_parquet_exact,
       format('s3://%s/lagodb-connectors/seed/parquet-prefix/',
              :'lakebase_regress_bucket') AS seed_parquet_prefix,
       format('s3://%s/lagodb-connectors/seed/parquet-prefix/part-a.parquet',
              :'lakebase_regress_bucket') AS seed_parquet_part_a,
       format('s3://%s/lagodb-connectors/seed/parquet-prefix/part-b.parquet',
              :'lakebase_regress_bucket') AS seed_parquet_part_b,
       format('s3://%s/lagodb-connectors/seed/extra-exact.txt',
              :'lakebase_regress_bucket') AS seed_extra_text_exact,
       format('s3://%s/lagodb-connectors/seed/extra-prefix/',
              :'lakebase_regress_bucket') AS seed_extra_text_prefix,
       format('s3://%s/lagodb-connectors/seed/extra-exact.csv',
              :'lakebase_regress_bucket') AS seed_extra_csv_exact,
       format('s3://%s/lagodb-connectors/seed/extra-prefix-csv/',
              :'lakebase_regress_bucket') AS seed_extra_csv_prefix
\gset
COPY lagodb_connectors_regress.common_source
TO :'seed_text_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'text');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 1
) TO :'seed_text_part_a'
WITH (server 'lagodb_connectors_regress_s3', format 'text');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 2
) TO :'seed_text_part_b'
WITH (server 'lagodb_connectors_regress_s3', format 'text');
COPY lagodb_connectors_regress.common_source
TO :'seed_csv_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'csv');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 1
) TO :'seed_csv_part_a'
WITH (server 'lagodb_connectors_regress_s3', format 'csv');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 2
) TO :'seed_csv_part_b'
WITH (server 'lagodb_connectors_regress_s3', format 'csv');
COPY lagodb_connectors_regress.common_source
TO :'seed_csv_header'
WITH (server 'lagodb_connectors_regress_s3', format 'csv', header true);
COPY lagodb_connectors_regress.common_source
TO :'seed_avro_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 1
) TO :'seed_avro_part_a'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
COPY (
    SELECT * FROM lagodb_connectors_regress.common_source WHERE id = 2
) TO :'seed_avro_part_b'
WITH (server 'lagodb_connectors_regress_s3', format 'avro');
COPY lagodb_connectors_regress.json_source
TO :'seed_json_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'json');
COPY (
    SELECT * FROM lagodb_connectors_regress.json_source WHERE id = 1
) TO :'seed_json_part_a'
WITH (server 'lagodb_connectors_regress_s3', format 'json');
COPY (
    SELECT * FROM lagodb_connectors_regress.json_source WHERE id = 2
) TO :'seed_json_part_b'
WITH (server 'lagodb_connectors_regress_s3', format 'json');
COPY lagodb_connectors_regress.json_source
TO :'seed_json_compressed'
WITH (server 'lagodb_connectors_regress_s3', format 'json', compression 'gzip');
COPY lagodb_connectors_regress.parquet_source
TO :'seed_parquet_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
COPY (
    SELECT * FROM lagodb_connectors_regress.parquet_source WHERE id = 1
) TO :'seed_parquet_part_a'
WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
COPY (
    SELECT * FROM lagodb_connectors_regress.parquet_source WHERE id = 2
) TO :'seed_parquet_part_b'
WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
COPY lagodb_connectors_regress.stream_extra_source
TO :'seed_extra_text_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'text');
COPY lagodb_connectors_regress.stream_extra_source
TO :'seed_extra_text_prefix'
WITH (server 'lagodb_connectors_regress_s3', format 'text');
COPY lagodb_connectors_regress.stream_extra_source
TO :'seed_extra_csv_exact'
WITH (server 'lagodb_connectors_regress_s3', format 'csv');
COPY lagodb_connectors_regress.stream_extra_source
TO :'seed_extra_csv_prefix'
WITH (server 'lagodb_connectors_regress_s3', format 'csv');
RESET client_min_messages;
