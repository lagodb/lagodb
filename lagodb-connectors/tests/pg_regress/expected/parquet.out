WITH (server 'lagodb_connectors_regress_s3', format 'parquet');
SELECT count(*) AS empty_prefix_rows FROM lagodb_connectors_regress.parquet_copy_sink;
 empty_prefix_rows 
-------------------
                 0
(1 row)

