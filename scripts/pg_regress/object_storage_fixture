#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
OBJECT_STORAGE_ENV=${OBJECT_STORAGE_ENV:-${SCRIPT_DIR}/object_storage.defaults.env}

if [ ! -f "$OBJECT_STORAGE_ENV" ]; then
    echo "object-storage fixture config not found: ${OBJECT_STORAGE_ENV}" >&2
    exit 2
fi

# shellcheck disable=SC1090
. "$OBJECT_STORAGE_ENV"

MINIO_IMAGE=${MINIO_IMAGE:-${DEFAULT_MINIO_IMAGE:?DEFAULT_MINIO_IMAGE is required in ${OBJECT_STORAGE_ENV}}}
MINIO_USER=${MINIO_USER:-${DEFAULT_MINIO_USER:?DEFAULT_MINIO_USER is required in ${OBJECT_STORAGE_ENV}}}
MINIO_PASSWORD=${MINIO_PASSWORD:-${DEFAULT_MINIO_PASSWORD:?DEFAULT_MINIO_PASSWORD is required in ${OBJECT_STORAGE_ENV}}}
MINIO_REGION=${MINIO_REGION:-${DEFAULT_MINIO_REGION:?DEFAULT_MINIO_REGION is required in ${OBJECT_STORAGE_ENV}}}
ICEBERG_REST_IMAGE=${ICEBERG_REST_IMAGE:-${DEFAULT_ICEBERG_REST_IMAGE:?DEFAULT_ICEBERG_REST_IMAGE is required in ${OBJECT_STORAGE_ENV}}}
SPARK_BASE_IMAGE=${SPARK_BASE_IMAGE:-${DEFAULT_SPARK_BASE_IMAGE:?DEFAULT_SPARK_BASE_IMAGE is required in ${OBJECT_STORAGE_ENV}}}
SPARK_IMAGE=${SPARK_IMAGE:-${DEFAULT_SPARK_IMAGE:?DEFAULT_SPARK_IMAGE is required in ${OBJECT_STORAGE_ENV}}}
REGRESS_BUCKET=${LAKEBASE_REGRESS_BUCKET:-lakebase-regress}
REGRESS_FALLBACK_BUCKET=${LAKEBASE_REGRESS_FALLBACK_BUCKET:-${REGRESS_BUCKET}-iceberg-fallback-a}
REGRESS_FALLBACK_SECOND_BUCKET=${LAKEBASE_REGRESS_FALLBACK_SECOND_BUCKET:-${REGRESS_BUCKET}-iceberg-fallback-b}
REGRESS_REGION=${LAKEBASE_REGRESS_REGION:-$MINIO_REGION}
READY_TIMEOUT_SECONDS=${LAKEBASE_REGRESS_READY_TIMEOUT_SECONDS:-30}
FIXTURE_LABEL_KEY=pg-lagodb.fixture
FIXTURE_LABEL_VALUE=pg-regress-object-storage
PGPORT_LABEL_KEY=pg-lagodb.pgport
STATE_DIR_LABEL_KEY=pg-lagodb.state-dir

case "${PGPORT:-}" in
    ''|*[!0-9]*)
        echo "PGPORT must be a decimal port number to isolate pg_regress fixture state" >&2
        exit 2
        ;;
esac

STATE_DIR="/tmp/pg_lakebase_object_regress_${PGPORT}"
STATE_ENV="${STATE_DIR}/state.env"
SETUP_STARTED=0

docker_program() {
    if [ "${DOCKER:-}" != "" ]; then
        printf '%s\n' "$DOCKER"
        return
    fi

    for candidate in \
        /Applications/Docker.app/Contents/Resources/bin/docker \
        /opt/homebrew/bin/docker \
        /usr/local/bin/docker
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    printf '%s\n' docker
}

state_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

container_name() {
    printf 'pg-lakebase-regress-minio-%s-%s\n' "$PGPORT" "$$"
}

network_name() {
    printf 'pg-lakebase-regress-%s-%s\n' "$PGPORT" "$$"
}

teardown_container() {
    if [ -f "$STATE_ENV" ]; then
        # shellcheck disable=SC1090
        . "$STATE_ENV"
        docker=${DOCKER_PATH:-$(docker_program)}
        if [ "${FAILURE_PROXY_PID:-}" != "" ]; then
            kill "$FAILURE_PROXY_PID" >/dev/null 2>&1 || true
        fi
        if [ "${CATALOG_PROXY_PID:-}" != "" ]; then
            kill "$CATALOG_PROXY_PID" >/dev/null 2>&1 || true
        fi
        if [ "${FALLBACK_REST_CONTAINER_ID:-}" != "" ]; then
            "$docker" rm --force "$FALLBACK_REST_CONTAINER_ID" \
                >/dev/null 2>&1 || true
        fi
        if [ "${REST_CONTAINER_ID:-}" != "" ]; then
            "$docker" rm --force "$REST_CONTAINER_ID" >/dev/null 2>&1 || true
        fi
        if [ "${CONTAINER_ID:-}" != "" ]; then
            "$docker" rm --force "$CONTAINER_ID" >/dev/null 2>&1 || true
        fi
        if [ "${NETWORK_ID:-}" != "" ]; then
            "$docker" network rm "$NETWORK_ID" >/dev/null 2>&1 || true
        fi
    fi
    rm -rf "$STATE_DIR"
}

cleanup_stale_containers() {
    docker=$1
    container_ids=$("$docker" ps -aq \
        --filter "label=${FIXTURE_LABEL_KEY}=${FIXTURE_LABEL_VALUE}" \
        2>/dev/null || true)

    for container_id in $container_ids; do
        container_pgport=$("$docker" inspect \
            --format "{{ index .Config.Labels \"${PGPORT_LABEL_KEY}\" }}" \
            "$container_id" 2>/dev/null || true)
        container_state_dir=$("$docker" inspect \
            --format "{{ index .Config.Labels \"${STATE_DIR_LABEL_KEY}\" }}" \
            "$container_id" 2>/dev/null || true)

        if [ "$container_pgport" = "$PGPORT" ]; then
            "$docker" rm --force "$container_id" >/dev/null 2>&1 || true
        elif [ "$container_state_dir" != "" ] \
            && [ "$container_state_dir" != "<no value>" ] \
            && [ ! -d "$container_state_dir" ]; then
            "$docker" rm --force "$container_id" >/dev/null 2>&1 || true
        fi
    done
}

cleanup_stale_networks() {
    docker=$1
    network_ids=$("$docker" network ls -q \
        --filter "label=${FIXTURE_LABEL_KEY}=${FIXTURE_LABEL_VALUE}" \
        2>/dev/null || true)

    for network_id in $network_ids; do
        network_pgport=$("$docker" network inspect \
            --format "{{ index .Labels \"${PGPORT_LABEL_KEY}\" }}" \
            "$network_id" 2>/dev/null || true)
        network_state_dir=$("$docker" network inspect \
            --format "{{ index .Labels \"${STATE_DIR_LABEL_KEY}\" }}" \
            "$network_id" 2>/dev/null || true)

        if [ "$network_pgport" = "$PGPORT" ]; then
            "$docker" network rm "$network_id" >/dev/null 2>&1 || true
        elif [ "$network_state_dir" != "" ] \
            && [ "$network_state_dir" != "<no value>" ] \
            && [ ! -d "$network_state_dir" ]; then
            "$docker" network rm "$network_id" >/dev/null 2>&1 || true
        fi
    done
}

cleanup_failed_setup() {
    if [ "$SETUP_STARTED" = "1" ]; then
        teardown_container
    fi
}

mapped_port() {
    docker=$1
    container_id=$2
    "$docker" port "$container_id" 9000/tcp \
        | sed -n 's/.*://p' \
        | head -n 1
}

wait_until_ready() {
    endpoint=$1
    deadline=$(( $(date +%s) + READY_TIMEOUT_SECONDS ))
    last_error=""

    while :; do
        if output=$(curl -fsS --max-time 1 "${endpoint}/minio/health/ready" 2>&1); then
            return 0
        fi
        last_error=$output

        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "MinIO did not become ready within ${READY_TIMEOUT_SECONDS} seconds: ${last_error}" >&2
            return 1
        fi

        sleep 0.1
    done
}

ensure_image() {
    docker=$1
    image=$2
    if ! "$docker" image inspect "$image" >/dev/null 2>&1; then
        if ! pull_output=$("$docker" pull "$image" 2>&1 >/dev/null); then
            echo "failed to pull Docker image ${image}" >&2
            echo "$pull_output" >&2
            exit 1
        fi
    fi
}

. "${SCRIPT_DIR}/iceberg_catalog_fixture"

setup() {
    teardown_container
    mkdir -p "$STATE_DIR"
    trap cleanup_failed_setup EXIT HUP INT TERM

    docker=$(docker_program)
    case "$docker" in
        */*)
            # Docker finds credential helpers through PATH even when its CLI
            # was selected by an absolute path.
            PATH="${docker%/*}:${PATH}"
            export PATH
            ;;
    esac
    name=$(container_name)
    fixture_network=$(network_name)
    cleanup_stale_containers "$docker"
    cleanup_stale_networks "$docker"

    ensure_image "$docker" "$MINIO_IMAGE"

    network_id=$("$docker" network create \
        --label "${FIXTURE_LABEL_KEY}=${FIXTURE_LABEL_VALUE}" \
        --label "${PGPORT_LABEL_KEY}=${PGPORT}" \
        --label "${STATE_DIR_LABEL_KEY}=${STATE_DIR}" \
        "$fixture_network")
    {
        printf 'DOCKER_PATH=%s\n' "$(state_quote "$docker")"
        printf 'NETWORK_ID=%s\n' "$(state_quote "$network_id")"
    } > "$STATE_ENV"
    SETUP_STARTED=1

    container_id=$("$docker" run \
        --rm \
        --detach \
        --publish 127.0.0.1::9000 \
        --network "$network_id" \
        --network-alias minio \
        --env "MINIO_ROOT_USER=${MINIO_USER}" \
        --env "MINIO_ROOT_PASSWORD=${MINIO_PASSWORD}" \
        --env "REGRESS_BUCKET=${REGRESS_BUCKET}" \
        --env "REGRESS_FALLBACK_BUCKET=${REGRESS_FALLBACK_BUCKET}" \
        --env "REGRESS_FALLBACK_SECOND_BUCKET=${REGRESS_FALLBACK_SECOND_BUCKET}" \
        --name "$name" \
        --label "${FIXTURE_LABEL_KEY}=${FIXTURE_LABEL_VALUE}" \
        --label "${PGPORT_LABEL_KEY}=${PGPORT}" \
        --label "${STATE_DIR_LABEL_KEY}=${STATE_DIR}" \
        --entrypoint /bin/sh \
        "$MINIO_IMAGE" \
        -c 'mkdir -p "/data/${REGRESS_BUCKET}" "/data/${REGRESS_FALLBACK_BUCKET}" "/data/${REGRESS_FALLBACK_SECOND_BUCKET}" && /usr/bin/minio server /data')

    {
        printf 'CONTAINER_ID=%s\n' "$(state_quote "$container_id")"
    } >> "$STATE_ENV"

    port=$(mapped_port "$docker" "$container_id")
    if [ "$port" = "" ]; then
        "$docker" logs --tail 80 "$container_id" >&2 || true
        teardown_container
        echo "Docker did not report a MinIO port mapping" >&2
        exit 1
    fi

    endpoint="http://127.0.0.1:${port}"

    if ! wait_until_ready "$endpoint"; then
        "$docker" logs --tail 80 "$container_id" >&2 || true
        teardown_container
        exit 1
    fi

    iceberg_start_rest_catalog "$docker" "$network_id"
    # shellcheck disable=SC1090
    . "$STATE_ENV"
    iceberg_provision_tables "$docker" "$network_id"
    iceberg_start_vending_proxy "$REST_UPSTREAM_URI" "$endpoint"
    # shellcheck disable=SC1090
    . "$STATE_ENV"
    iceberg_start_failure_proxy "$REST_URI"
    # shellcheck disable=SC1090
    . "$STATE_ENV"

    psql -X -v ON_ERROR_STOP=1 \
        --set=endpoint="$endpoint" \
        --set=bucket="$REGRESS_BUCKET" \
        --set=fallback_bucket="$REGRESS_FALLBACK_BUCKET" \
        --set=fallback_second_bucket="$REGRESS_FALLBACK_SECOND_BUCKET" \
        --set=region="$REGRESS_REGION" \
        --set=access_key_id="$MINIO_USER" \
        --set=secret_access_key="$MINIO_PASSWORD" \
        --set=rest_uri="$REST_URI" \
        --set=fallback_rest_uri="$FALLBACK_REST_URI" \
        --set=failure_rest_uri="$FAILURE_REST_URI" >/dev/null <<'SQL'
SET client_min_messages = warning;
CREATE SCHEMA IF NOT EXISTS lakebase_regress;
DROP TABLE IF EXISTS lakebase_regress.object_storage_fixture;
RESET client_min_messages;
CREATE TABLE lakebase_regress.object_storage_fixture (
    endpoint text NOT NULL,
    bucket text NOT NULL,
    fallback_bucket text NOT NULL,
    fallback_second_bucket text NOT NULL,
    region text NOT NULL,
    access_key_id text NOT NULL,
    secret_access_key text NOT NULL,
    rest_uri text NOT NULL,
    fallback_rest_uri text NOT NULL,
    failure_rest_uri text NOT NULL
);
INSERT INTO lakebase_regress.object_storage_fixture
VALUES (
    :'endpoint', :'bucket', :'fallback_bucket', :'fallback_second_bucket',
    :'region', :'access_key_id',
    :'secret_access_key', :'rest_uri', :'fallback_rest_uri',
    :'failure_rest_uri'
);
SQL

    SETUP_STARTED=0
    trap - EXIT HUP INT TERM
    echo "object_storage_setup: true"
}

teardown() {
    teardown_container
    cleanup_stale_containers "$(docker_program)"
    cleanup_stale_networks "$(docker_program)"
    echo "object_storage_teardown: true"
}

rest_stop() {
    # shellcheck disable=SC1090
    . "$STATE_ENV"
    "${DOCKER_PATH:-$(docker_program)}" stop "$REST_CONTAINER_ID" >/dev/null
    echo "iceberg_rest_stopped: true"
}

rest_start() {
    # shellcheck disable=SC1090
    . "$STATE_ENV"
    docker=${DOCKER_PATH:-$(docker_program)}
    "$docker" start "$REST_CONTAINER_ID" >/dev/null
    iceberg_wait_for_url \
        "Iceberg REST catalog" "${REST_UPSTREAM_URI}/v1/config"
    echo "iceberg_rest_started: true"
}

reprovision() {
    # shellcheck disable=SC1090
    . "$STATE_ENV"
    iceberg_provision_tables "${DOCKER_PATH:-$(docker_program)}" "$NETWORK_ID"
    echo "object_storage_reprovisioned: true"
}

case "${1:-}" in
    setup)
        if [ "$#" -ne 1 ]; then
            echo "usage: object_storage_fixture setup|teardown|reprovision|rest-stop|rest-start" >&2
            exit 2
        fi
        setup
        ;;
    teardown)
        if [ "$#" -ne 1 ]; then
            echo "usage: object_storage_fixture setup|teardown" >&2
            exit 2
        fi
        teardown
        ;;
    rest-stop)
        rest_stop
        ;;
    rest-start)
        rest_start
        ;;
    reprovision)
        reprovision
        ;;
    *)
        echo "usage: object_storage_fixture setup|teardown|reprovision|rest-stop|rest-start" >&2
        exit 2
        ;;
esac
